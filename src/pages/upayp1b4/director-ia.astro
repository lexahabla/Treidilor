    .director-ia-page .punto-voz--hablando { background: #22c55e; box-shadow: 0 0 6px #22c55e; }
    .director-ia-page .punto-voz--listo { background: var(--di-suave); }
    @keyframes director-ia-pulso-voz { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    /* botones del panel (solo dentro de esta página) */
    .director-ia-page .btn-primary, .director-ia-page .btn-secondary { padding: 0.5rem 0.9rem; border-radius: 999px; border: 1px solid transparent; font: inherit; font-weight: 600; font-size: 0.85rem; cursor: pointer; line-height: 1.2; }
    .director-ia-page .btn-primary { background: #ececf1; color: #0d1424; }
    .director-ia-page .btn-primary:hover:not(:disabled) { background: #fff; }
    .director-ia-page .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .director-ia-page .btn-secondary { background: transparent; color: var(--di-texto); border-color: #334155; }
    .director-ia-page .btn-secondary:hover:not(:disabled) { background: var(--di-hover); }
    .director-ia-page .btn-secondary:disabled { opacity: 0.5; cursor: not-allowed; }
    .director-ia-page .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; }
    @media (prefers-reduced-motion: reduce) { .director-ia-sidebar, .director-ia-burbuja, .director-ia-voz .director-ia-ondas line { transition: none !important; animation: none !important; } }

    /* escritorio: la barra lateral se contrae y se despliega (como ChatGPT) */
    @media (min-width: 861px) {
      .director-ia-page.barra-contraida .director-ia-sidebar { display: none; }
    }
    /* móvil y tableta vertical: la barra pasa a panel superpuesto dentro del área del chat; el botón de la cabecera la abre */
    @media (max-width: 860px) {
      .director-ia-page { border-radius: 12px; }
      .admin-wrapper { padding: 1rem 0.5rem 0; gap: 0.75rem; }
      .director-ia-btn-barra { display: inline-flex; }
      .director-ia-sidebar {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 40;
        width: min(85vw, 300px);
        padding-top: max(0.5rem, env(safe-area-inset-top));
        padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
        transform: translateX(-105%);
        transition: transform 0.22s ease;
        visibility: hidden;
      }
      .director-ia-sidebar.abierta { transform: none; visibility: visible; box-shadow: 0 0 40px rgba(0, 0, 0, 0.6); }
      .director-ia-sidebar.abierta + .director-ia-chat::after { content: ''; position: absolute; inset: 0; z-index: 30; background: rgba(0, 0, 0, 0.5); }
      .director-ia-chat-header { min-height: 48px; padding-left: 0.4rem; cursor: default; }
      .director-ia-chat-sub { display: none; }
      .director-ia-burbuja--usuario { max-width: 85%; }
      .director-ia-mensajes { padding: 1rem 1rem 1.5rem; gap: 1rem; }
      .director-ia-form { padding: 0 0.5rem max(0.4rem, env(safe-area-inset-bottom)); }
      #inputMensaje { font-size: 16px; } /* con menos de 16 px, iOS amplía la página al enfocar el campo y descoloca la distribución */
      .director-ia-modo-voz { max-width: 10.5rem; padding-right: 0.4rem; }
      .director-ia-vacio-centrado { font-size: 1.3rem; }
    }
    html.director-ia-max .director-ia-page { border-radius: 0; }
    /* compacto (teclado abierto, pantalla muy baja): lo mínimo arriba para dar sitio al hilo */
