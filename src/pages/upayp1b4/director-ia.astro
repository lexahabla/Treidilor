---
/**
 * TREIDILOR — /upayp1b4/director-ia  (apartado «Director IA» del panel).
 *
 * Chat conversacional con el Director 00 a través del puente persistente
 * (Canal 13). Reusa AdminNav, autenticación administrativa, estilos del
 * panel y el almacén persistente de conversaciones.
 *
 * La conversación del Director es ÚNICA y COMPARTIDA con Telegram
 * (conversación principal, fuente de verdad del historial). El panel no
 * crea conversaciones independientes ni permite eliminar el historial
 * compartido por error.
 */
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminSectionHeader from '../../components/admin/AdminSectionHeader.astro';
import AdminUserMenu from '../../components/AdminUserMenu.astro';
import { getSessionUser } from '../../lib/adminAuth';

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/upayp1b4');
if (!sessionUser.master) return Astro.redirect('/upayp1b4/perfil');

Astro.response.headers.set('Cache-Control', 'no-store');

const activeSection = 'director-ia';
---

<Layout title="Director IA | Panel Treidilor" description="Conversa con el Director IA de Treidilor (Agente 00). Historial persistente compartido con Telegram.">
  <Fragment slot="header-end">
    <script is:inline data-director-ia-max>try { document.documentElement.classList.add('director-ia-max'); } catch (e) { /* sin clase: se amplía al cargar */ }</script>
    <AdminUserMenu user={sessionUser} active={activeSection} />
  </Fragment>
  <div class="admin-wrapper">
    <AdminSectionHeader
      eyebrow="Centro de operaciones y agentes"
      title="Director IA"
      subtitle="Gestiona TREIDILOR mediante conversaciones, coordina agentes y supervisa sus tareas, resultados y autorizaciones."
      ids={{ eyebrow: 'directorIaHeaderPill', title: 'directorIaHeaderTitle', subtitle: 'directorIaHeaderSubtitle' }}
    />
    <AdminNav context="catalogo" active={activeSection} user={sessionUser} />

    <main class="director-ia-page" id="directorIaApp">
      <aside class="director-ia-sidebar" id="barraChats" aria-label="Chats del Director">
        <div class="director-ia-sidebar-top">
          <span class="director-ia-marca">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z"></path></svg>
            Director IA
          </span>
          <button type="button" id="btnContraerBarra" class="director-ia-icono" title="Cerrar la barra lateral" aria-label="Cerrar la barra lateral" aria-controls="barraChats">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"></rect><line x1="9" y1="4" x2="9" y2="20"></line></svg>
          </button>
        </div>
        <div class="director-ia-sidebar-head director-ia-sidebar-acciones">
          <button type="button" id="btnNuevoChat" class="director-ia-nav-item" title="Nuevo chat (Alt+N)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
            <span>Nuevo chat</span>
          </button>
          <label class="director-ia-nav-item director-ia-buscar-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.5" y2="16.5"></line></svg>
            <input type="search" id="buscarChats" class="director-ia-buscar" placeholder="Buscar chats" title="Buscar chats (Ctrl+K)" aria-label="Buscar chats" autocomplete="off" />
          </label>
          <button type="button" id="btnNuevoProyecto" class="director-ia-nav-item" title="Nuevo proyecto o carpeta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path><line x1="12" y1="11" x2="12" y2="16"></line><line x1="9.5" y1="13.5" x2="14.5" y2="13.5"></line></svg>
            <span>Nuevo proyecto</span>
          </button>
        </div>
        <div class="director-ia-vistas" role="tablist" aria-label="Vista de chats">
          <button type="button" role="tab" class="director-ia-vista" data-vista="activos" aria-selected="true">Chats</button>
          <button type="button" role="tab" class="director-ia-vista" data-vista="archivados" aria-selected="false">Archivados</button>
          <button type="button" role="tab" class="director-ia-vista" data-vista="papelera" aria-selected="false">Papelera</button>
        </div>
        <nav id="listaChats" class="director-ia-lista" aria-label="Lista de chats"></nav>
        <div id="listaConversaciones" hidden></div>
        <div class="director-ia-sidebar-pie">
          <div id="estadoConexion" class="director-ia-estado" role="status" aria-live="polite">
            <span class="punto punto--desconectado" aria-hidden="true"></span>
            <span id="textoEstado">Comprobando conexión…</span>
          </div>
          <div class="director-ia-config" aria-label="Configuración de conversación">
            <button type="button" id="btnConfigurarConversacion" class="director-ia-icono" title="Configurar ID de conversación (para compartir con Telegram)" aria-label="Configurar ID de conversación">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
            </button>
            <div id="panelConfiguracion" class="director-ia-config-panel" hidden>
              <label class="director-ia-config-label">ID de conversación (Telegram / panel):</label>
              <input type="text" id="inputConversacionId" placeholder="cv_..." maxlength="64" spellcheck="false" />
              <button type="button" id="btnGuardarConversacionId" class="btn-primary btn-sm">Guardar</button>
              <button type="button" id="btnLimpiarConversacionId" class="btn-secondary btn-sm" style="margin-left:0.4rem">Limpiar</button>
              <div id="alertaConversacionId" class="director-ia-alerta" hidden role="alert" aria-live="assertive"></div>
            </div>
          </div>
        </div>
      </aside>

      <section class="director-ia-chat" aria-label="Chat">
        <div class="director-ia-chat-header">
          <button type="button" id="btnBarraChats" class="director-ia-btn-barra director-ia-icono" aria-controls="barraChats" aria-expanded="false" title="Abrir la barra lateral" aria-label="Abrir la barra lateral">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"></rect><line x1="9" y1="4" x2="9" y2="20"></line></svg>
          </button>
          <div class="director-ia-chat-titulos">
            <h1 id="tituloConversacion">Director IA</h1>
            <p id="subtituloConversacion" class="director-ia-chat-sub">Conversación principal compartida con Telegram.</p>
          </div>
          <div class="director-ia-chat-herr">
            <button type="button" id="btnMaximizar" class="director-ia-icono" title="Ampliar la conversación a toda la pantalla" aria-label="Ampliar la conversación a toda la pantalla">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
            </button>
            <button type="button" id="btnCerrarMax" class="director-ia-icono director-ia-cerrar-max" title="Cerrar y volver al panel de administración (Esc). La conversación sigue igual." aria-label="Cerrar la pantalla completa y volver al panel de administración" hidden>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </div>
        <section id="confirmacionesPendientes" class="director-ia-confirmaciones" hidden aria-live="polite">
          <h2>
            <button type="button" id="btnPlegarAprobaciones" class="director-ia-plegar" aria-expanded="true" aria-controls="cuerpoAprobaciones">
              <span class="director-ia-punto-aprob" aria-hidden="true"></span>
              <span>Aprobaciones del Director</span>
              <span id="cuentaAprobaciones" class="director-ia-cuenta"></span>
              <svg class="director-ia-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
          </h2>
          <div id="cuerpoAprobaciones">
            <p class="director-ia-chat-sub">Operaciones que el Director solo hace con tu aprobación. Las consultas y propuestas se aprueban con tu sesión; las sensibles piden tu contraseña. Horas en hora de Madrid.</p>
            <div id="listaConfirmaciones"></div>
            <details id="historialConfirmaciones" hidden><summary>Resueltas recientemente</summary><div></div></details>
          </div>
        </section>

        <!-- Solo el hilo se desplaza: la cabecera de arriba y el editor de abajo quedan siempre a la vista. -->
        <div class="director-ia-hilo">
          <div class="director-ia-mensajes" id="contenedorMensajes" role="log" aria-live="polite">
            <div class="director-ia-vacio-centrado">Selecciona o crea una conversación para empezar a hablar con el Director.</div>
          </div>
          <button type="button" id="btnIrAlFinal" class="director-ia-ir-final" hidden aria-label="Ir a los mensajes nuevos">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
            <span>Mensajes nuevos</span>
          </button>
        </div>
        <form id="formMensaje" class="director-ia-form">
          <div id="listaAdjuntos" class="director-ia-adjuntos" aria-label="Archivos adjuntos" hidden></div>
          <div class="director-ia-input-wrap">
            <textarea
              id="inputMensaje"
              rows="1"
              placeholder="Pregunta lo que quieras al Director"
              title="Enter envía · Mayús+Enter, salto de línea"
              aria-label="Mensaje al Director IA"
              autocomplete="off"
              spellcheck="true"
              maxlength="2000"
            ></textarea>
            <button type="button" id="btnAdjuntar" class="director-ia-icono" title="Adjuntar archivos (también puedes arrastrarlos o pegar capturas)" aria-label="Adjuntar archivos">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </button>
            <input type="file" id="inputArchivos" multiple hidden accept=".png,.jpg,.jpeg,.webp,.pdf,.docx,.xlsx,.csv,.txt,.md,.json" />
            <select id="modoVoz" class="director-ia-modo-voz" title="Modo de la conversación por voz" aria-label="Modo de voz">
              <option value="director">Voz del Director</option>
              <option value="rapida">Voz rápida (te reconoce el navegador)</option>
            </select>
            <select id="vozElegida" class="director-ia-modo-voz director-ia-voz-elegida" title="Voz con la que te responde el Director (local, sin límite diario). Provisional hasta que la escuches y elijas" aria-label="Voz del Director">
              <option value="alex">Alex (provisional)</option>
              <option value="dora">Dora</option>
              <option value="santa">Santa</option>
            </select>
            <button type="button" id="btnMuestraVoz" class="director-ia-icono" title="Escuchar una muestra de esta voz" aria-label="Escuchar una muestra de esta voz" aria-pressed="false">
              <svg class="muestra-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
              <svg class="muestra-stop" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"></rect></svg>
            </button>
            <button type="button" id="btnAltavoz" class="director-ia-icono director-ia-altavoz" aria-pressed="false" title="Respuestas solo por escrito. Pulsa para que el Director también las lea en voz alta" aria-label="Respuestas solo por escrito. Pulsa para que el Director también las lea en voz alta">
              <svg class="altavoz-no" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4Z"></path><line x1="22" y1="9" x2="16" y2="15"></line><line x1="16" y1="9" x2="22" y2="15"></line></svg>
              <svg class="altavoz-si" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4Z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path><path d="M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
            </button>
            <button type="button" id="btnDetenerVoz" class="director-ia-icono" title="Interrumpir al Director y volver a escuchar" hidden aria-label="Interrumpir al Director">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2"></rect></svg>
            </button>
            <button type="button" id="btnVoz" class="director-ia-voz" title="Conversación por voz con el Director" aria-label="Conversación por voz con el Director" aria-pressed="false">
              <svg class="director-ia-ondas" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <line class="o1" x1="4" y1="10" x2="4" y2="14"></line>
                <line class="o2" x1="8" y1="6.5" x2="8" y2="17.5"></line>
                <line class="o3" x1="12" y1="3.5" x2="12" y2="20.5"></line>
                <line class="o4" x1="16" y1="7.5" x2="16" y2="16.5"></line>
                <line class="o5" x1="20" y1="10" x2="20" y2="14"></line>
              </svg>
              <span id="textoBtnVoz" class="texto-btn-voz">Hablar</span>
            </button>
            <button type="submit" id="btnEnviar" class="director-ia-enviar" disabled title="Enviar (Enter)" aria-label="Enviar mensaje">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
            </button>
          </div>
          <div id="alertaForm" class="director-ia-alerta" hidden role="alert" aria-live="assertive"></div>
          <div id="estadoVoz" class="director-ia-estado-voz" hidden role="status" aria-live="polite">
            <span class="punto-voz" aria-hidden="true"></span>
            <span id="textoEstadoVoz">Listo para hablar</span>
          </div>
          <p class="director-ia-aviso-pie">El Director puede equivocarse. Las operaciones sensibles siempre piden tu aprobación.</p>
        </form>
      </section>
    </main>
  </div>

  <script is:inline>
    (function () {
      const API_BASE = '/api/admin/director-ia';

      const els = {
        contenedor: document.getElementById('contenedorMensajes'),
        form: document.getElementById('formMensaje'),
        input: document.getElementById('inputMensaje'),
        btnEnviar: document.getElementById('btnEnviar'),
        btnAdjuntar: document.getElementById('btnAdjuntar'),
        btnVoz: document.getElementById('btnVoz'),
        btnDetenerVoz: document.getElementById('btnDetenerVoz'),
        titulo: document.getElementById('tituloConversacion'),
        subtitulo: document.getElementById('subtituloConversacion'),
        estado: document.getElementById('estadoConexion'),
        textoEstado: document.getElementById('textoEstado'),
        alerta: document.getElementById('alertaForm'),
        btnConfigurarConversacion: document.getElementById('btnConfigurarConversacion'),
        panelConfiguracion: document.getElementById('panelConfiguracion'),
        inputConversacionId: document.getElementById('inputConversacionId'),
        btnGuardarConversacionId: document.getElementById('btnGuardarConversacionId'),
        btnLimpiarConversacionId: document.getElementById('btnLimpiarConversacionId'),
        alertaConversacionId: document.getElementById('alertaConversacionId'),
      };

      let enVuelo = false;
      let conversacionIdConfigurada = null;

      // ── configuración de conversación (compartir con Telegram) ──
      function leerConversacionIdGuardada() {
        try {
          const v = localStorage.getItem('directorIa_conversacionId');
          return v || null;
        } catch { return null; }
      }
      function guardarConversacionId(id) {
        try { localStorage.setItem('directorIa_conversacionId', id || ''); } catch { /* sin localStorage */ }
        conversacionIdConfigurada = id || null;
      }
      function urlConConversacionId(path) {
        if (!conversacionIdConfigurada) return path;
        const sep = path.includes('?') ? '&' : '?';
        return `${path}${sep}conversacionId=${encodeURIComponent(conversacionIdConfigurada)}`;
      }
      function mostrarAlertaConversacionId(texto) {
        if (!els.alertaConversacionId) return;
        els.alertaConversacionId.hidden = !texto;
        if (texto) els.alertaConversacionId.textContent = texto;
      }

      // ── estado de conexión ──
      async function comprobarEstado() {
        try {
          const res = await fetch(`${API_BASE}/status`, { headers: { 'cache-control': 'no-store' } });
          const j = await leerJson(res);
          if (j.success && j.conectado) {
            ponerEstado('conectado', 'Conectado con el Director.');
          } else {
            ponerEstado('desconectado', j.motivo === 'no_configurado'
              ? 'Servicio no configurado en el servidor.'
              : 'No se pudo contactar con el servicio del Director.');
          }
        } catch {
          ponerEstado('desconectado', 'Servicio no disponible.');
        }
      }

      function ponerEstado(tipo, texto) {
        if (!els.estado || !els.textoEstado) return;
        const punto = els.estado.querySelector('.punto');
        els.textoEstado.textContent = texto;
        els.estado.className = 'director-ia-estado director-ia-estado--' + tipo;
        if (punto) punto.className = 'punto punto--' + tipo;
      }

      // Si el Director se está reiniciando (instalación) o la web se está redesplegando, la carga falla unos segundos: antes el aviso se quedaba
      // fijo hasta recargar la página. Ahora se muestra el motivo, un botón «Reintentar» y se reintenta solo (3 s, 8 s y 20 s). Solo LEE el historial.
      let reintentoPrincipal = null;
      async function cargarConversacionPrincipal(intento = 0) {
        if (!els.contenedor) return;
        if (reintentoPrincipal) { clearTimeout(reintentoPrincipal); reintentoPrincipal = null; }
        const pedidaPara = conversacionIdConfigurada;
        if (!intento) els.contenedor.innerHTML = '<div class="director-ia-cargando">Cargando historial…</div>';
        try {
          const res = await fetch(urlConConversacionId(`${API_BASE}/principal`), { headers: { 'cache-control': 'no-store' } });
          const j = await leerJson(res);
          if (!j.success) throw new Error(j.message || 'No se pudo cargar el historial');
          if (pedidaPara !== conversacionIdConfigurada) return; // mientras tanto se abrió otro chat
          renderizarMensajes(j.conversacion);
        } catch (e) {
          if (pedidaPara !== conversacionIdConfigurada) return;
          const espera = [3000, 8000, 20000][intento] || 0; const motivo = e instanceof Error && e.message ? e.message : '';
          els.contenedor.innerHTML = '';
          const caja = document.createElement('div'); caja.className = 'director-ia-error';
          caja.textContent = 'No se pudo cargar la conversación principal.' + (motivo ? ` (${motivo})` : '') + (espera ? ` Vuelvo a intentarlo en ${Math.round(espera / 1000)} s.` : '');
          const b = document.createElement('button'); b.type = 'button'; b.className = 'btn-secondary btn-sm director-ia-reintentar'; b.textContent = 'Reintentar';
          b.addEventListener('click', () => cargarConversacionPrincipal(0)); caja.appendChild(b); els.contenedor.appendChild(caja);
          if (espera) reintentoPrincipal = setTimeout(() => cargarConversacionPrincipal(intento + 1), espera);
          console.error(e);
        }
      }

      // ── historial: carga progresiva y desplazamiento que respeta la posición del lector ──
      const POR_BLOQUE = 40;
      let mensajesActuales = []; let mostradosDesde = 0;
      // pegadoAlFinal: lo actualiza el desplazamiento real; mantiene el final a la vista cuando cambia el TAMAÑO del hilo (teclado, campo que crece, adjuntos).
      // siguiendoHasta: mientras dura el desplazamiento suave hacia lo nuevo, sigues «al final» aunque la animación aún no haya llegado.
      let pegadoAlFinal = true; let siguiendoHasta = 0;
      // Una burbuja que cambia de alto después de pintarse (fuente que termina de cargar, imagen adjunta) no te despega del final.
      const vigiaBurbujas = typeof ResizeObserver === 'function' ? new ResizeObserver(() => { const c = els.contenedor; if (c && pegadoAlFinal && Date.now() >= siguiendoHasta) c.scrollTop = c.scrollHeight; }) : null;
      function cercaDelFinal() { const c = els.contenedor; return !c || (c.scrollHeight - c.scrollTop - c.clientHeight) < 140 || Date.now() < siguiendoHasta; }
      function botonAnteriores() {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'btn-secondary btn-sm director-ia-cargar-anteriores';
        b.textContent = `Ver ${Math.min(POR_BLOQUE, mostradosDesde)} mensajes anteriores`;
        b.addEventListener('click', () => {
          const c = els.contenedor; const antes = c.scrollHeight; const desde = Math.max(0, mostradosDesde - POR_BLOQUE);
          const nodos = mensajesActuales.slice(desde, mostradosDesde).map(crearNodoMensaje);
          const ref = b.nextSibling || null; if (b.parentNode) b.parentNode.removeChild(b);
          for (const n of nodos) { if (c.insertBefore) c.insertBefore(n, ref); else c.appendChild(n); }
          mostradosDesde = desde;
          if (desde > 0) { const nb = botonAnteriores(); if (c.insertBefore) c.insertBefore(nb, c.firstChild || null); else c.appendChild(nb); }
          c.scrollTop += c.scrollHeight - antes; // conserva lo que estabas leyendo
        });
        return b;
      }

      function renderizarMensajes(conversacion) {
        if (!els.contenedor || !els.titulo || !els.subtitulo) return;
        els.titulo.textContent = (Chats.actual() && Chats.actual().titulo) || conversacion.titulo || 'Director IA';
        els.subtitulo.textContent = (Chats.actual() && Chats.actual().confidencial ? '🔒 Confidencial: sin modelo externo ni voz. ' : '') + (conversacion.mensajes && conversacion.mensajes.length
          ? conversacion.mensajes.length + ' mensaje' + (conversacion.mensajes.length === 1 ? '' : 's') + ' · ' + fechaLegera(conversacion.actualizadoEn)
          : 'Sin mensajes aún.');
        els.contenedor.innerHTML = '';
        mensajesActuales = Array.isArray(conversacion.mensajes) ? conversacion.mensajes : [];
        mostradosDesde = Math.max(0, mensajesActuales.length - POR_BLOQUE);
        if (mostradosDesde > 0) els.contenedor.appendChild(botonAnteriores());
        for (const m of mensajesActuales.slice(mostradosDesde)) els.contenedor.appendChild(crearNodoMensaje(m));
        if (!mensajesActuales.length) { const v = document.createElement('div'); v.className = 'director-ia-vacio-centrado'; v.textContent = 'Escribe o habla para empezar esta conversación con el Director.'; els.contenedor.appendChild(v); }
        scrollFinal(true);
      }

      function crearNodoMensaje(m) {
        const div = document.createElement('div');
        div.className = 'director-ia-burbuja director-ia-burbuja--' + m.rol;
        if (vigiaBurbujas) vigiaBurbujas.observe(div);
        const hora = m.en ? fechaHora(m.en) : '';
        // Trazabilidad sin mezclarla con la conversación: el estado, el registro y la intención quedan en el texto emergente de la línea de hora.
        // «no registrada» solo si el Director dice que no se registró (los mensajes del historial vienen de su registro y no traen `controles`).
        const meta = [];
        if (m.rol === 'director') {
          if (m.estado) meta.push('estado: ' + m.estado);
          if (m.registrada === false || (m.controles && m.controles.registrada === false)) meta.push('no registrada');
          if (m.tipoIntencion) meta.push('intención: ' + m.tipoIntencion);
        }
        const metaHtml = '';
        const cuerpo = document.createElement('div');
        cuerpo.className = 'director-ia-burbuja-cuerpo md';
        cuerpo.innerHTML = renderMarkdown(m.contenido ?? '');
        div.innerHTML =
          '<div class="director-ia-burbuja-cabecera">' +
          (m.rol === 'usuario' ? 'Tú' : 'Director IA') + ' <span class="director-ia-burbuja-hora">' + escapeHtml(hora) + '</span>' +
          metaHtml +
          '</div>';
        div.appendChild(cuerpo);
        if (meta.length && div.firstChild && div.firstChild.setAttribute) div.firstChild.setAttribute('title', meta.join(' · '));
        if (m.rol === 'director') {
          const extras = document.createElement('div');
          extras.innerHTML = renderizarExtrasDirector(m);
          div.appendChild(extras);
        }
        if (Array.isArray(m.adjuntos) && m.adjuntos.length) {
          const caja = document.createElement('div'); caja.className = 'director-ia-burbuja-adjuntos';
          for (const a of m.adjuntos) {
            if (!/^ad_[0-9a-f]{16}$/.test(String(a.id))) continue; const url = `${API_BASE}/adjuntos?id=${encodeURIComponent(a.id)}`;
            if (['png', 'jpg', 'webp'].includes(a.tipo)) { const im = document.createElement('img'); im.src = url; im.alt = a.nombre || 'imagen adjunta'; im.loading = 'lazy'; caja.appendChild(im); }
            else { const ln = document.createElement('a'); ln.href = url; ln.textContent = '📄 ' + (a.nombre || 'documento'); ln.setAttribute('download', a.nombre || 'documento'); caja.appendChild(ln); }
          }
          div.appendChild(caja);
        }
        const acc = document.createElement('div'); acc.className = 'director-ia-burbuja-acciones';
        const bCopiar = document.createElement('button'); bCopiar.type = 'button'; bCopiar.textContent = 'Copiar'; bCopiar.setAttribute('aria-label', 'Copiar el mensaje');
        bCopiar.addEventListener('click', () => copiarTexto(m.contenido ?? '', bCopiar));
        const bReusar = document.createElement('button'); bReusar.type = 'button'; bReusar.textContent = 'Reutilizar'; bReusar.setAttribute('aria-label', 'Llevar el mensaje al campo de escritura');
        bReusar.addEventListener('click', () => { if (els.input) { els.input.value = String(m.contenido ?? '').slice(0, 2000); ajustarAltura(); if (els.btnEnviar) els.btnEnviar.disabled = !els.input.value.trim() || enVuelo; els.input.focus(); } });
        acc.appendChild(bCopiar); acc.appendChild(bReusar); div.appendChild(acc);
        return div;
      }

      async function copiarTexto(texto, boton) {
        let ok = false;
        try { if (window.navigator && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(String(texto)); ok = true; } } catch { ok = false; }
        if (!ok) { try { const t = document.createElement('textarea'); t.value = String(texto); document.body.appendChild(t); t.select(); ok = document.execCommand('copy'); t.remove(); } catch { ok = false; } }
        if (boton) { const antes = boton.textContent; boton.textContent = ok ? 'Copiado' : 'No se pudo copiar'; setTimeout(() => { boton.textContent = antes; }, 1500); }
      }

      /**
       * Markdown SEGURO: primero se escapa TODO el texto (ningún HTML del mensaje llega al DOM) y después se aplica un subconjunto:
       * párrafos, títulos, negrita, cursiva, código en línea y en bloque, listas, tablas y enlaces http(s) (abren aparte, sin referer).
       */
      function renderMarkdown(texto) {
        const lineas = String(texto ?? '').replace(/\r\n?/g, '\n').split('\n'); const salida = []; let i = 0;
        const enlinea = (t) => escapeHtml(t)
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/(^|[^*\w])\*([^*\s][^*]*)\*/g, '$1<em>$2</em>')
          .replace(/\[([^\]]{1,200})\]\((https?:\/\/[^\s)"'<>]{1,500})\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer nofollow">$1</a>')
          .replace(/(^|[\s(])(https?:\/\/[^\s<)"']{1,500})/g, '$1<a href="$2" target="_blank" rel="noopener noreferrer nofollow">$2</a>');
        const esTabla = (l) => /^\s*\|.*\|\s*$/.test(l);
        const celdas = (l) => l.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim());
        const especial = /^```|^#{1,6}\s|^\s*([-*•]|\d+[.)])\s+/;
        while (i < lineas.length) {
          const l = lineas[i];
          if (/^```/.test(l)) { const cod = []; i += 1; while (i < lineas.length && !/^```/.test(lineas[i])) { cod.push(lineas[i]); i += 1; } i += 1; salida.push('<pre><code>' + escapeHtml(cod.join('\n')) + '</code></pre>'); continue; }
          const h = /^(#{1,6})\s+(.*)$/.exec(l); if (h) { const n = Math.min(6, h[1].length + 2); salida.push('<h' + n + '>' + enlinea(h[2]) + '</h' + n + '>'); i += 1; continue; }
          if (esTabla(l) && i + 1 < lineas.length && /^\s*\|?\s*:?-{2,}/.test(lineas[i + 1])) {
            const cab = celdas(l); i += 2; const filas = []; while (i < lineas.length && esTabla(lineas[i])) { filas.push(celdas(lineas[i])); i += 1; }
            salida.push('<table><thead><tr>' + cab.map((c) => '<th>' + enlinea(c) + '</th>').join('') + '</tr></thead><tbody>' + filas.map((f) => '<tr>' + f.map((c) => '<td>' + enlinea(c) + '</td>').join('') + '</tr>').join('') + '</tbody></table>'); continue;
          }
          if (/^\s*([-*•]|\d+[.)])\s+/.test(l)) {
            const ordenada = /^\s*\d+[.)]/.test(l); const items = [];
            while (i < lineas.length && /^\s*([-*•]|\d+[.)])\s+/.test(lineas[i])) { items.push(lineas[i].replace(/^\s*([-*•]|\d+[.)])\s+/, '')); i += 1; }
            salida.push((ordenada ? '<ol>' : '<ul>') + items.map((x) => '<li>' + enlinea(x) + '</li>').join('') + (ordenada ? '</ol>' : '</ul>')); continue;
          }
          if (!l.trim()) { i += 1; continue; }
          const parr = []; while (i < lineas.length && lineas[i].trim() && !especial.test(lineas[i]) && !esTabla(lineas[i])) { parr.push(enlinea(lineas[i])); i += 1; }
          if (!parr.length) { parr.push(enlinea(l)); i += 1; }
          salida.push('<p>' + parr.join('<br>') + '</p>');
        }
        return salida.join('');
      }

      function renderizarExtrasDirector(m) {
        const partes = [];
        if (m.naturalezaDatos && m.naturalezaDatos.length) {
          partes.push('<div class="director-ia-dato">Naturaleza: ' + m.naturalezaDatos.map((n) => escapeHtml(n.etiqueta)).join(', ') + '</div>');
        }
        if (m.fuentes && m.fuentes.length) {
          partes.push('<div class="director-ia-fuentes">Fuentes: ' + m.fuentes.map((f) => escapeHtml(f.texto) + (f.procedencia ? ' (' + escapeHtml(f.procedencia) + ')' : '')).join('; ') + '</div>');
        }
        if (m.tareas && m.tareas.length) {
          partes.push('<div class="director-ia-tareas">Tareas: ' + m.tareas.map((t) => escapeHtml(t.idTarea) + ' (' + escapeHtml(t.estado) + ')').join(', ') + '</div>');
        }
        if (m.solicitudesAutorizacion && m.solicitudesAutorizacion.length) {
          partes.push('<div class="director-ia-auth">Pendientes de tu aprobación: ' + m.solicitudesAutorizacion.map((s) => escapeHtml(s.idAprobacion) + ' ' + escapeHtml(s.nivel)).join(', ') + '</div>');
        }
        if (m.limitaciones && m.limitaciones.length) {
          partes.push('<div class="director-ia-limites">⚠ ' + m.limitaciones.map(escapeHtml).join('; ') + '</div>');
        }
        if (m.avisos && m.avisos.length) {
          partes.push('<div class="director-ia-avisos">' + m.avisos.map((a) => '⚠ ' + escapeHtml(a)).join('<br>') + '</div>');
        }
        return partes.join('');
      }

      /**
       * Lee la respuesta como JSON solo si el servidor la envía como JSON. Una sesión caducada (texto
       * «Autenticacion requerida»), una página de error del proxy o un HTML se convierten en un error
       * comprensible en lugar de «Unexpected token <».
       */
      async function leerJson(res) {
        const tipo = res.headers.get('content-type') || '';
        if (!tipo.includes('application/json')) {
          if (res.status === 401) throw new Error('La sesión ha caducado. Vuelve a iniciar sesión en el panel.');
          throw new Error(`El servidor no respondió con datos válidos (HTTP ${res.status}).`);
        }
        return res.json();
      }

      async function enviarConCabeceraSegura(url, init) {
        const cabeceras = { 'Content-Type': 'application/json; charset=utf-8', ...(init.headers || {}) };
        if (init.method && (init.method.toUpperCase() === 'POST' || init.method.toUpperCase() === 'PUT' || init.method.toUpperCase() === 'DELETE' || init.method.toUpperCase() === 'PATCH')) {
          cabeceras['X-Director-IA'] = '1';
        }
        return fetch(url, { ...init, headers: cabeceras });
      }

      // ── enviar mensaje ──
      async function enviarMensaje(e) {
        e.preventDefault();
        if (enVuelo) return;
        const listos = Adjuntos.listos(); if (Adjuntos.subiendo()) { mostrarAlerta('Espera a que terminen de subirse los archivos.'); return; }
        const texto = els.input.value.trim();
        if (!texto && !listos.length) return;
        enVuelo = true;
        els.btnEnviar.disabled = true;
        els.input.disabled = true;
        mostrarAlerta(null);

        // mensaje de usuario optimista
        const ahora = new Date().toISOString();
        const nodoUsuario = crearNodoMensaje({ rol: 'usuario', contenido: texto || 'Te adjunto estos documentos.', en: ahora, adjuntos: listos });
        els.contenedor.appendChild(nodoUsuario);
        els.input.value = ''; ajustarAltura();
        scrollFinal(true);
        Chats.tocar(texto);

        try {
          const res = await enviarConCabeceraSegura(urlConConversacionId(`${API_BASE}/principal`), {
            method: 'POST',
            body: JSON.stringify({ texto, ...(listos.length ? { adjuntos: listos.map((a) => a.id) } : {}) }),
          });
          const j = await leerJson(res);
          if (!j.success) throw new Error(j.message || 'Error del servidor');
          Adjuntos.vaciar(false);

          const nodoDirector = crearNodoMensaje({
            rol: 'director',
            contenido: j.respuesta.textoClaro,
            en: j.respuesta.generadoEn || ahora,
            estado: j.respuesta.estado,
            categoria: j.respuesta.categoria,
            tipoIntencion: j.respuesta.tipoIntencion,
            naturalezaDatos: j.respuesta.naturalezaDatos,
            fuentes: j.respuesta.fuentes,
            tareas: j.respuesta.tareas,
            solicitudesAutorizacion: j.respuesta.solicitudesAutorizacion,
            limitaciones: j.respuesta.limitaciones,
            avisos: j.respuesta.avisos,
            controles: j.respuesta.controles,
            registrada: j.respuesta.registrada,
            generadoEn: j.respuesta.generadoEn,
          });
          alHilo(nodoDirector);
        } catch (err) {
          mostrarAlerta(err instanceof Error ? err.message : 'No se pudo enviar el mensaje.');
          // no se pierde lo escrito: el mensaje queda marcado y se puede reintentar (o se recupera en el campo de escritura)
          if (nodoUsuario.classList) nodoUsuario.classList.add('director-ia-burbuja--error');
          const reint = document.createElement('button'); reint.type = 'button'; reint.className = 'btn-secondary btn-sm'; reint.textContent = 'Reintentar';
          reint.addEventListener('click', () => { if (nodoUsuario.parentNode) nodoUsuario.parentNode.removeChild(nodoUsuario); els.input.value = texto; ajustarAltura(); if (els.form && els.form.requestSubmit) els.form.requestSubmit(); else enviarMensaje({ preventDefault() {} }); });
          nodoUsuario.appendChild(reint);
          if (!els.input.value) { els.input.value = texto; ajustarAltura(); }
        } finally {
          enVuelo = false;
          els.btnEnviar.disabled = !els.input.value.trim();
          els.input.disabled = false;
          els.input.focus();
        }
      }

      function mostrarAlerta(texto) {
        if (!els.alerta) return;
        els.alerta.hidden = !texto;
        if (texto) els.alerta.textContent = texto;
      }

      function fechaLegera(iso) {
        if (!iso) return '';
        try {
          const d = new Date(iso);
          return d.toLocaleString('es-ES', { timeZone: 'Europe/Madrid', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        } catch { return iso; }
      }

      function fechaHora(iso) {
        if (!iso) return '';
        try {
          const d = new Date(iso);
          return d.toLocaleTimeString('es-ES', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' });
        } catch { return iso; }
      }

      function escapeHtml(texto) {
        return String(texto ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      /**
       * Baja al final solo si se fuerza (lo que acabas de enviar, cambio de chat) o si estabas al final ANTES de que llegara lo nuevo
       * (`estaba`, medido antes de añadirlo: una respuesta larga ya no te «despega»); si estabas leyendo más arriba, no te mueve y avisa.
       * Lo forzado es inmediato; acompañar una respuesta nueva, suave.
       */
      function scrollFinal(forzar = false, estaba = cercaDelFinal()) {
        const c = els.contenedor; if (!c) return;
        const btn = document.getElementById('btnIrAlFinal');
        if (forzar || estaba) {
          pegadoAlFinal = true;
          if (!forzar && typeof c.scrollTo === 'function') { siguiendoHasta = Date.now() + 900; c.scrollTo({ top: c.scrollHeight, behavior: 'smooth' }); } else c.scrollTop = c.scrollHeight;
          if (btn) btn.hidden = true;
        } else if (btn) btn.hidden = false;
      }
      /** Añade mensajes al hilo respetando dónde estabas leyendo. */
      function alHilo(...nodos) { const estaba = cercaDelFinal(); for (const n of nodos) if (n) els.contenedor.appendChild(n); scrollFinal(false, estaba); }
      function mantenerFinal(fn) { const c = els.contenedor; const estaba = pegadoAlFinal; fn(); if (c && estaba) c.scrollTop = c.scrollHeight; }
      /** El campo crece con lo escrito hasta un tope (≤ 192 px y ≤ 30 % de la altura visible); a partir de ahí, scroll interno. */
      function ajustarAltura() {
        const t = els.input; if (!t || !t.style) return;
        const visible = (window.visualViewport && window.visualViewport.height) || window.innerHeight || 800;
        mantenerFinal(() => { t.style.height = 'auto'; t.style.height = Math.min(t.scrollHeight || 0, 192, Math.max(64, Math.round(visible * 0.3))) + 'px'; });
      }

      // ── eventos ──
      if (els.form) els.form.addEventListener('submit', enviarMensaje);
      const btnFinal = document.getElementById('btnIrAlFinal');
      if (btnFinal) btnFinal.addEventListener('click', () => { const c = els.contenedor; pegadoAlFinal = true; if (c && typeof c.scrollTo === 'function') { siguiendoHasta = Date.now() + 900; c.scrollTo({ top: c.scrollHeight, behavior: 'smooth' }); } else scrollFinal(true); btnFinal.hidden = true; });
      if (els.contenedor && els.contenedor.addEventListener) els.contenedor.addEventListener('scroll', () => { pegadoAlFinal = cercaDelFinal(); if (btnFinal && pegadoAlFinal) btnFinal.hidden = true; }, { passive: true });

      // ── DISTRIBUCIÓN tipo aplicación: la página no se desplaza; el área del chat ocupa exactamente la altura VISIBLE que queda bajo la
      // cabecera del sitio (teclado virtual, giro, zoom). Con el teclado abierto o una pantalla muy baja se recogen
      // la cabecera del sitio y el menú del panel, para que el editor nunca quede tapado ni fuera de la vista.
      (function distribucion() {
        const raiz = document.documentElement; const pagina = document.querySelector ? document.querySelector('.director-ia-page') : null;
        if (!pagina || !raiz || !raiz.classList || !pagina.getBoundingClientRect || !pagina.style || !window.addEventListener) return;
        raiz.classList.add('director-ia-app');
        const vv = window.visualViewport || null; let pedido = false;
        function medir() {
          pedido = false;
          const visible = vv ? vv.height : window.innerHeight;
          mantenerFinal(() => {
            const max = raiz.classList.contains('director-ia-max');
            raiz.classList.toggle('director-ia-compacto', max && visible < 560);
            if (max) {
              // ampliada: la ventana no se desplaza (sin teclado, arriba del todo) y el chat ocupa exactamente la altura visible
              if (window.scrollY && visible >= window.innerHeight * 0.9 && window.scrollTo) window.scrollTo(0, 0);
              const fondo = vv ? vv.offsetTop + vv.height : window.innerHeight;
              pagina.style.setProperty('--di-alto', Math.max(200, Math.floor(fondo - pagina.getBoundingClientRect().top)) + 'px');
            } else {
              // vista normal del panel: la PÁGINA se desplaza entera (rueda, panel táctil, dedo); el chat mide la ventana visible y no depende del scroll
              pagina.style.setProperty('--di-alto', Math.max(420, Math.floor(visible - 24)) + 'px');
            }
          });
        }
        const pedir = () => { if (pedido) return; pedido = true; (window.requestAnimationFrame || setTimeout)(medir); };
        medir();
        window.addEventListener('resize', pedir); window.addEventListener('orientationchange', pedir); window.addEventListener('load', pedir);
        if (vv && vv.addEventListener) { vv.addEventListener('resize', pedir); vv.addEventListener('scroll', pedir); }
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(pedir).catch(() => {});
        if (typeof ResizeObserver === 'function') {
          const ro = new ResizeObserver(pedir); for (const s of ['.site-header', '.admin-header', '.admin-section-nav']) { const e = document.querySelector(s); if (e) ro.observe(e); }
          // el editor cambia de alto (campo que crece, adjuntos, estado de voz): si estabas al final, sigues viéndolo
          const ro2 = new ResizeObserver(() => { const c = els.contenedor; if (c && pegadoAlFinal) c.scrollTop = c.scrollHeight; });
          if (els.form) ro2.observe(els.form); if (els.contenedor) ro2.observe(els.contenedor);
        }
      })();
      if (els.input) {
        els.input.addEventListener('input', () => {
          els.btnEnviar.disabled = !els.input.value.trim() || enVuelo;
          mostrarAlerta(null);
          ajustarAltura();
        });
        els.input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); if (!enVuelo && (els.input.value.trim() || Adjuntos.listos().length)) enviarMensaje({ preventDefault() {} }); }
        });
      }

      // ── ADJUNTOS: selector, arrastrar y soltar y pegar capturas; se suben al chat abierto (nunca al catálogo) y se envían con el mensaje ──
      const Adjuntos = (function () {
        const MAX = 8; const MAX_BYTES = 10 * 1024 * 1024; let items = []; let n = 0;
        const caja = document.getElementById('listaAdjuntos'); const input = document.getElementById('inputArchivos');
        const tam = (b) => (b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB');
        const textoEstado = (it) => it.estado === 'subiendo' ? 'subiendo…' : it.estado === 'error' ? (it.motivo || 'error') : (['png', 'jpg', 'webp'].includes(it.tipo) ? 'imagen (sin análisis visual)' : it.texto && it.texto.estado === 'ok' ? 'listo para leer' : it.texto && it.texto.estado === 'truncado' ? 'listo (texto recortado)' : (it.texto && it.texto.motivo) || 'sin texto legible');
        function pintar() {
          if (!caja) return; caja.textContent = ''; caja.hidden = !items.length;
          for (const it of items) {
            const f = document.createElement('div'); f.className = 'director-ia-adjunto' + (it.estado === 'error' ? ' director-ia-adjunto--error' : ''); f.setAttribute('role', 'group'); f.setAttribute('aria-label', `Adjunto ${it.nombre}`);
            if (it.vista) { const im = document.createElement('img'); im.src = it.vista; im.alt = ''; f.appendChild(im); }
            const t = document.createElement('div'); const nm = document.createElement('div'); nm.className = 'nombre'; nm.textContent = it.nombre; nm.title = it.nombre;
            const es = document.createElement('div'); es.className = 'estado'; es.textContent = `${tam(it.bytes)} · ${textoEstado(it)}`; t.appendChild(nm); t.appendChild(es); f.appendChild(t);
            const q = document.createElement('button'); q.type = 'button'; q.textContent = '✕'; q.setAttribute('aria-label', `Quitar ${it.nombre}`); q.addEventListener('click', () => quitar(it)); f.appendChild(q);
            caja.appendChild(f);
          }
        }
        async function subir(it) {
          const chat = conversacionIdConfigurada; if (!chat) { it.estado = 'error'; it.motivo = 'abre un chat primero'; pintar(); return; }
          try {
            const r = await fetch(`${API_BASE}/adjuntos?conversacionId=${encodeURIComponent(chat)}`, { method: 'POST', headers: { 'Content-Type': 'application/octet-stream', 'X-Director-IA': '1', 'X-Nombre-Archivo': encodeURIComponent(it.nombre) }, body: it.archivo });
            const j = await leerJson(r); if (!j.success) throw new Error(j.message || 'no se pudo subir');
            Object.assign(it, { estado: 'listo', id: j.adjunto.id, tipo: j.adjunto.tipo, texto: j.adjunto.texto, chat });
          } catch (e) { it.estado = 'error'; it.motivo = e instanceof Error ? e.message : 'no se pudo subir'; }
          pintar();
        }
        function anadir(lista) {
          const archivos = Array.from(lista || []); if (!archivos.length) return;
          for (const a of archivos) {
            if (items.length >= MAX) { mostrarAlerta(`Hasta ${MAX} archivos por mensaje.`); break; }
            const it = { clave: ++n, archivo: a, nombre: a.name || `captura-${n}.png`, bytes: a.size || 0, estado: 'subiendo', vista: null };
            if (it.bytes > MAX_BYTES) { it.estado = 'error'; it.motivo = 'supera 10 MB'; }
