        function cortar() { gen += 1; const a = actual; actual = null; if (a && typeof a.pause === 'function') { try { a.pause(); } catch { /* nada */ } } }
        /** url de la primera frase + habla {id,total} (o null): alEmpezar() al sonar la primera, alTerminar('completada'|'fallida') al acabar. */
        function decir(url, habla, { alEmpezar = null, alTerminar = null } = {}) {
          cortar(); const mio = gen; const total = habla && habla.id && habla.total > 1 ? Math.min(20, habla.total) : 1; const siguientes = new Map(); let empezo = false;
          const pedir = (n) => { if (n < total && !siguientes.has(n)) { const pr = pedirFrase(habla.id, n); pr.catch(() => {}); siguientes.set(n, pr); } };
