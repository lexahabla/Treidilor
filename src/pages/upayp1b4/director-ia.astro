    html.director-ia-max .site-footer, html.director-ia-max .back-to-top { display: none !important; }
    /* mismo contenedor que el resto del panel (Desarrollo IA): ancho máximo centrado, mismos márgenes y separación entre cabecera, menú y contenido */
    .admin-wrapper { max-width: var(--max-width); margin: 0 auto; padding: 2.5rem 1.25rem 5rem; display: flex; flex-direction: column; gap: 30px; }
    html.director-ia-max .admin-wrapper { padding-bottom: 0 !important; margin-bottom: 0 !important; }
    html.director-ia-compacto .admin-wrapper { padding-top: 0.4rem; gap: 0.4rem; }
    /* teclado abierto o pantalla muy baja: también la cabecera del sitio y el menú del panel */
    html.director-ia-compacto .site-header, html.director-ia-compacto .admin-section-nav { display: none !important; }
    html.director-ia-compacto .admin-wrapper > .admin-header { display: none !important; }
    /* vista ampliada: solo la conversación */
    html.director-ia-max .site-header, html.director-ia-max .admin-wrapper > .admin-header, html.director-ia-max .admin-section-nav { display: none !important; }
    .director-ia-page [hidden] { display: none !important; }

