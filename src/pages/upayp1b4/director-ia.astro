        return { activo: () => activo, poner, alSilenciar: (f) => avisos.push(f), salida, reproduccion, marcarSinCupo, sinCupo: () => sinCupo };
      })();

      // ── LOCUTOR: reproduce la respuesta del Director POR FRASES (Director 1.3.8). La primera llega con el turno; mientras suena, se pide la
      // siguiente (el Director ya la está sintetizando), así no hay que esperar a que toda la respuesta esté sintetizada. Cortar detiene lo que suena
      // y descarta lo pendiente al instante (interrumpir, silenciar, nuevo turno).
      const Locutor = (function () {
        let actual = null; let gen = 0;
        async function pedirFrase(id, n) {
          const res = await fetch(`${API_BASE}/principal`, { method: 'POST', headers: { 'content-type': 'application/json', 'X-Director-IA': '1' }, body: JSON.stringify({ fraseVoz: { id, n } }) });
          const j = await leerJson(res); if (!j || !j.success || !j.audio || !j.audio.base64) throw new Error('sin frase');
          return `data:${j.audio.mime};base64,${j.audio.base64}`;
