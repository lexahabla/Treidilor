          b.title = t; b.setAttribute('aria-label', t);
          if (b.classList) { if (activo) b.classList.add('activo'); else b.classList.remove('activo'); if (sinCupo) b.classList.add('sin-cupo'); else b.classList.remove('sin-cupo'); }
        }
        // Lo que el panel sabe de la SALIDA (Director 1.3.7): se envía con cada turno hablado para que el Director diagnostique «no te oigo» con hechos.
        let sinCupo = false; let ultimaReproduccion = 'ninguna';
        const salida = () => ({ altavoz: activo ? 'activado' : 'desactivado', motor: modoVozActual(), ultimaReproduccion, voz: vozElegidaActual() });
        const reproduccion = (r) => { if (['completada', 'fallida', 'cortada', 'ninguna'].includes(r)) ultimaReproduccion = r; };
