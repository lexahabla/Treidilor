        function vaciar(borrar) { const antes = items; items = []; pintar(); for (const it of antes) { if (it.vista && window.URL && URL.revokeObjectURL) URL.revokeObjectURL(it.vista); if (borrar && it.id) enviarConCabeceraSegura(`${API_BASE}/adjuntos?id=${encodeURIComponent(it.id)}`, { method: 'DELETE' }).catch(() => {}); } }
        if (els.btnAdjuntar && input) els.btnAdjuntar.addEventListener('click', () => input.click());
