      function mostrarAlerta(texto) {
        if (!els.alerta) return;
        els.alerta.hidden = !texto;
        if (texto) els.alerta.textContent = texto;
      }

      function fechaLegera(iso) {
        if (!iso) return '';
        try {
          const d = new Date(iso);
          return d.toLocaleString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        } catch { return iso; }
      }

      function fechaHora(iso) {
        if (!iso) return '';
        try {
          const d = new Date(iso);
          return d.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        } catch { return iso; }
      }

      function escapeHtml(texto) {
        return String(texto ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      /** Baja al final solo si se fuerza (lo que acabas de enviar, cambio de chat) o si ya estabas cerca del final; si no, avisa. */
      function scrollFinal(forzar = false) {
        if (!els.contenedor) return;
        const btn = document.getElementById('btnIrAlFinal');
        if (forzar || cercaDelFinal()) { els.contenedor.scrollTop = els.contenedor.scrollHeight; if (btn) btn.hidden = true; }
        else if (btn) btn.hidden = false;
      }
      function ajustarAltura() { const t = els.input; if (!t || !t.style) return; t.style.height = 'auto'; t.style.height = Math.min(t.scrollHeight || 0, 192) + 'px'; }

      // ── eventos ──
      if (els.form) els.form.addEventListener('submit', enviarMensaje);
      const btnFinal = document.getElementById('btnIrAlFinal');
      if (btnFinal) btnFinal.addEventListener('click', () => scrollFinal(true));
      if (els.contenedor && els.contenedor.addEventListener) els.contenedor.addEventListener('scroll', () => { if (btnFinal && cercaDelFinal()) btnFinal.hidden = true; });
      if (els.input) {
        els.input.addEventListener('input', () => {
          els.btnEnviar.disabled = !els.input.value.trim() || enVuelo;
          mostrarAlerta(null);
          ajustarAltura();
        });
        els.input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); if (!enVuelo && els.input.value.trim()) enviarMensaje({ preventDefault() {} }); }
        });
      }

      if (els.btnAdjuntar) {
        els.btnAdjuntar.addEventListener('click', () => {
          mostrarAlerta('Funciones adicionales pendientes (adjuntar contexto de ficha/categoría).');
        });
      }

