---
/**
 * TREIDILOR — /upayp1b4/director-ia  (apartado «Director IA» del panel).
 *
 * Chat conversacional con el Director 00 a través del puente persistente
 * (Canal 13). Reusa AdminNav, autenticación administrativa, estilos del
 * panel y el almacén persistente de conversaciones.
 *
 * La conversación del Director es ÚNICA y COMPARTIDA con Telegram
 * (conversación principal, fuente de verdad del historial). El panel no
 * crea conversaciones independientes ni permite eliminar el historial
 * compartido por error.
 */
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminSectionHeader from '../../components/admin/AdminSectionHeader.astro';
import AdminUserMenu from '../../components/AdminUserMenu.astro';
import { getSessionUser } from '../../lib/adminAuth';

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/upayp1b4');
if (!sessionUser.master) return Astro.redirect('/upayp1b4/perfil');

Astro.response.headers.set('Cache-Control', 'no-store');

const activeSection = 'director-ia';
---

<Layout title="Director IA | Panel Treidilor" description="Conversa con el Director IA de Treidilor (Agente 00). Historial persistente compartido con Telegram.">
  <Fragment slot="header-end">
    <AdminUserMenu user={sessionUser} active={activeSection} />
  </Fragment>
  <div class="admin-wrapper">
    <AdminSectionHeader
      eyebrow="Director IA"
      titulo="Asistente conversacional"
      subtitle="Habla con el Director 00 en lenguaje natural. El historial se guarda en el servidor y se recupera al volver."
      ids={{ eyebrow: 'directorIaHeaderPill', title: 'directorIaHeaderTitle', subtitle: 'directorIaHeaderSubtitle' }}
    />
    <AdminNav context="catalogo" active={activeSection} user={sessionUser} />

    <main class="director-ia-page">
      <aside class="director-ia-sidebar" aria-label="Conversación del Director">
        <div class="director-ia-sidebar-head">
          <h2 class="director-ia-sidebar-title">Conversación</h2>
          <div class="director-ia-sidebar-tipo">Principal · compartida con Telegram</div>
        </div>
        <div id="listaConversaciones" class="director-ia-lista" role="list" aria-hidden="true">
          <div class="director-ia-vacio">Una sola conversación principal (compartida con Telegram).</div>
        </div>
        <div id="estadoConexion" class="director-ia-estado" role="status" aria-live="polite">
          <span class="punto punto--desconectado" aria-hidden="true"></span>
          <span id="textoEstado">Comprobando conexión…</span>
        </div>
        <div class="director-ia-config" aria-label="Configuración de conversación">
          <button type="button" id="btnConfigurarConversacion" class="btn-secondary btn-sm" title="Configurar ID de conversación (para compartir con Telegram)">🔗</button>
          <div id="panelConfiguracion" class="director-ia-config-panel" hidden>
            <label class="director-ia-config-label">ID de conversación (Telegram / panel):</label>
            <input type="text" id="inputConversacionId" placeholder="cv_..." maxlength="64" spellcheck="false" />
            <button type="button" id="btnGuardarConversacionId" class="btn-primary btn-sm">Guardar</button>
            <button type="button" id="btnLimpiarConversacionId" class="btn-secondary btn-sm" style="margin-left:0.4rem">Limpiar</button>
            <div id="alertaConversacionId" class="director-ia-alerta" hidden role="alert" aria-live="assertive"></div>
          </div>
        </div>
      </aside>

      <section class="director-ia-chat" aria-label="Chat">
        <div class="director-ia-chat-header">
          <h1 id="tituloConversacion">Director IA</h1>
          <p id="subtituloConversacion" class="director-ia-chat-sub">Conversación principal compartida con Telegram.</p>
          <section id="confirmacionesPendientes" class="director-ia-confirmaciones" hidden aria-live="polite">
            <h2>Confirmaciones pendientes</h2>
            <p class="director-ia-chat-sub">Operaciones que el Director solo aplica con tu confirmación. Se te pedirá la contraseña.</p>
            <div id="listaConfirmaciones"></div>
          </section>
        </div>

        <div class="director-ia-mensajes" id="contenedorMensajes" role="log" aria-live="polite">
          <div class="director-ia-vacio-centrado">Selecciona o crea una conversación para empezar a hablar con el Director.</div>
        </div>

        <form id="formMensaje" class="director-ia-form">
          <div class="director-ia-input-wrap">
            <input
              type="text"
              id="inputMensaje"
              placeholder="Escribe tu mensaje al Director…"
              aria-label="Mensaje al Director IA"
              autocomplete="off"
              spellcheck="false"
              maxlength="2000"
            />
            <button type="button" id="btnVoz" class="btn-secondary btn-sm" title="Hablar con el Director (micrófono)" aria-pressed="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3Z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="23"></line>
                <line x1="8" y1="23" x2="16" y2="23"></line>
              </svg>
              <span id="textoBtnVoz" class="texto-btn-voz">Hablar</span>
            </button>
            <button type="button" id="btnDetenerVoz" class="btn-secondary btn-sm" title="Interrumpir al Director y volver a escuchar" hidden aria-label="Interrumpir al Director">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="6" height="6"></rect>
              </svg>
            </button>
            <button type="button" id="btnAdjuntar" class="btn-secondary btn-sm" title="Opciones de la conversación">⋮</button>
            <button type="submit" id="btnEnviar" class="btn-primary btn-sm" disabled>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
          <div id="alertaForm" class="director-ia-alerta" hidden role="alert" aria-live="assertive"></div>
          <div id="estadoVoz" class="director-ia-estado-voz" hidden role="status" aria-live="polite">
            <span class="punto-voz" aria-hidden="true"></span>
            <span id="textoEstadoVoz">Listo para hablar</span>
          </div>
        </form>
      </section>
    </main>
  </div>

  <script is:inline>
    (function () {
      const API_BASE = '/api/admin/director-ia';

      const els = {
        contenedor: document.getElementById('contenedorMensajes'),
        form: document.getElementById('formMensaje'),
        input: document.getElementById('inputMensaje'),
        btnEnviar: document.getElementById('btnEnviar'),
        btnAdjuntar: document.getElementById('btnAdjuntar'),
        btnVoz: document.getElementById('btnVoz'),
        btnDetenerVoz: document.getElementById('btnDetenerVoz'),
        titulo: document.getElementById('tituloConversacion'),
        subtitulo: document.getElementById('subtituloConversacion'),
        estado: document.getElementById('estadoConexion'),
        textoEstado: document.getElementById('textoEstado'),
        alerta: document.getElementById('alertaForm'),
        btnConfigurarConversacion: document.getElementById('btnConfigurarConversacion'),
        panelConfiguracion: document.getElementById('panelConfiguracion'),
        inputConversacionId: document.getElementById('inputConversacionId'),
        btnGuardarConversacionId: document.getElementById('btnGuardarConversacionId'),
        btnLimpiarConversacionId: document.getElementById('btnLimpiarConversacionId'),
        alertaConversacionId: document.getElementById('alertaConversacionId'),
      };

      let enVuelo = false;
      let conversacionIdConfigurada = null;

      // ── configuración de conversación (compartir con Telegram) ──
      function leerConversacionIdGuardada() {
        try {
          const v = localStorage.getItem('directorIa_conversacionId');
          return v || null;
        } catch { return null; }
      }
      function guardarConversacionId(id) {
        try { localStorage.setItem('directorIa_conversacionId', id || ''); } catch { /* sin localStorage */ }
        conversacionIdConfigurada = id || null;
      }
      function urlConConversacionId(path) {
        if (!conversacionIdConfigurada) return path;
        const sep = path.includes('?') ? '&' : '?';
        return `${path}${sep}conversacionId=${encodeURIComponent(conversacionIdConfigurada)}`;
      }
      function mostrarAlertaConversacionId(texto) {
        if (!els.alertaConversacionId) return;
        els.alertaConversacionId.hidden = !texto;
        if (texto) els.alertaConversacionId.textContent = texto;
      }

      // ── estado de conexión ──
      async function comprobarEstado() {
        try {
          const res = await fetch(`${API_BASE}/status`, { headers: { 'cache-control': 'no-store' } });
          const j = await leerJson(res);
          if (j.success && j.conectado) {
            ponerEstado('conectado', 'Conectado con el Director.');
          } else {
            ponerEstado('desconectado', j.motivo === 'no_configurado'
              ? 'Servicio no configurado en el servidor.'
              : 'No se pudo contactar con el servicio del Director.');
          }
        } catch {
          ponerEstado('desconectado', 'Servicio no disponible.');
        }
      }

      function ponerEstado(tipo, texto) {
        if (!els.estado || !els.textoEstado) return;
        const punto = els.estado.querySelector('.punto');
        els.textoEstado.textContent = texto;
        els.estado.className = 'director-ia-estado director-ia-estado--' + tipo;
        if (punto) punto.className = 'punto punto--' + tipo;
      }

      async function cargarConversacionPrincipal() {
        if (!els.contenedor) return;
        els.contenedor.innerHTML = '<div class="director-ia-cargando">Cargando historial…</div>';
        try {
          const res = await fetch(urlConConversacionId(`${API_BASE}/principal`), { headers: { 'cache-control': 'no-store' } });
          const j = await leerJson(res);
          if (!j.success) throw new Error(j.message || 'No se pudo cargar el historial');
          renderizarMensajes(j.conversacion);
        } catch (e) {
          els.contenedor.innerHTML = '<div class="director-ia-error">No se pudo cargar la conversación principal.</div>';
          console.error(e);
        }
      }

      function renderizarMensajes(conversacion) {
        if (!els.contenedor || !els.titulo || !els.subtitulo) return;
        els.titulo.textContent = conversacion.titulo || 'Director IA';
        els.subtitulo.textContent = conversacion.mensajes && conversacion.mensajes.length
          ? conversacion.mensajes.length + ' mensaje' + (conversacion.mensajes.length === 1 ? '' : 's') + ' · ' + fechaLegera(conversacion.actualizadoEn)
          : 'Sin mensajes aún.';
        els.contenedor.innerHTML = '';
        if (conversacion.mensajes && conversacion.mensajes.length) {
          for (const m of conversacion.mensajes) {
            els.contenedor.appendChild(crearNodoMensaje(m));
          }
        }
        scrollFinal();
      }

      function crearNodoMensaje(m) {
        const div = document.createElement('div');
        div.className = 'director-ia-burbuja director-ia-burbuja--' + m.rol;
        const hora = m.en ? fechaHora(m.en) : '';
        const meta = [];
        if (m.rol === 'director') {
          if (m.estado) meta.push(m.estado);
          if (!m.controles || m.controles.registrada === false) meta.push('no registrada');
          if (m.tipoIntencion) meta.push('intención: ' + m.tipoIntencion);
        }
        const metaHtml = meta.length ? '<span class="director-ia-meta">' + escapeHtml(meta.join(' · ')) + '</span>' : '';
        const cuerpo = document.createElement('div');
        cuerpo.className = 'director-ia-burbuja-cuerpo';
        cuerpo.textContent = m.contenido ?? '';
        div.innerHTML =
          '<div class="director-ia-burbuja-cabecera">' +
          (m.rol === 'usuario' ? 'Tú' : 'Director IA') + ' <span class="director-ia-burbuja-hora">' + escapeHtml(hora) + '</span>' +
          metaHtml +
          '</div>';
        div.appendChild(cuerpo);
        if (m.rol === 'director') {
          const extras = document.createElement('div');
          extras.innerHTML = renderizarExtrasDirector(m);
          div.appendChild(extras);
        }
        return div;
      }

      function renderizarExtrasDirector(m) {
        const partes = [];
        if (m.naturalezaDatos && m.naturalezaDatos.length) {
          partes.push('<div class="director-ia-dato">Naturaleza: ' + m.naturalezaDatos.map((n) => escapeHtml(n.etiqueta)).join(', ') + '</div>');
        }
        if (m.fuentes && m.fuentes.length) {
          partes.push('<div class="director-ia-fuentes">Fuentes: ' + m.fuentes.map((f) => escapeHtml(f.texto) + (f.procedencia ? ' (' + escapeHtml(f.procedencia) + ')' : '')).join('; ') + '</div>');
        }
        if (m.tareas && m.tareas.length) {
          partes.push('<div class="director-ia-tareas">Tareas: ' + m.tareas.map((t) => escapeHtml(t.idTarea) + ' (' + escapeHtml(t.estado) + ')').join(', ') + '</div>');
        }
        if (m.solicitudesAutorizacion && m.solicitudesAutorizacion.length) {
          partes.push('<div class="director-ia-auth">Pendientes de tu aprobación: ' + m.solicitudesAutorizacion.map((s) => escapeHtml(s.idAprobacion) + ' ' + escapeHtml(s.nivel)).join(', ') + '</div>');
        }
        if (m.limitaciones && m.limitaciones.length) {
          partes.push('<div class="director-ia-limites">⚠ ' + m.limitaciones.map(escapeHtml).join('; ') + '</div>');
        }
        if (m.avisos && m.avisos.length) {
          partes.push('<div class="director-ia-avisos">' + m.avisos.map((a) => '⚠ ' + escapeHtml(a)).join('<br>') + '</div>');
        }
        return partes.join('');
      }

      /**
       * Lee la respuesta como JSON solo si el servidor la envía como JSON. Una sesión caducada (texto
       * «Autenticacion requerida»), una página de error del proxy o un HTML se convierten en un error
       * comprensible en lugar de «Unexpected token <».
       */
      async function leerJson(res) {
        const tipo = res.headers.get('content-type') || '';
        if (!tipo.includes('application/json')) {
          if (res.status === 401) throw new Error('La sesión ha caducado. Vuelve a iniciar sesión en el panel.');
          throw new Error(`El servidor no respondió con datos válidos (HTTP ${res.status}).`);
        }
        return res.json();
      }

      async function enviarConCabeceraSegura(url, init) {
        const cabeceras = { 'Content-Type': 'application/json; charset=utf-8', ...(init.headers || {}) };
        if (init.method && (init.method.toUpperCase() === 'POST' || init.method.toUpperCase() === 'PUT' || init.method.toUpperCase() === 'DELETE' || init.method.toUpperCase() === 'PATCH')) {
          cabeceras['X-Director-IA'] = '1';
        }
        return fetch(url, { ...init, headers: cabeceras });
      }

      // ── enviar mensaje ──
      async function enviarMensaje(e) {
        e.preventDefault();
        if (enVuelo) return;
        const texto = els.input.value.trim();
        if (!texto) return;
        enVuelo = true;
        els.btnEnviar.disabled = true;
        els.input.disabled = true;
        mostrarAlerta(null);

        // mensaje de usuario optimista
        const ahora = new Date().toISOString();
        const nodoUsuario = crearNodoMensaje({ rol: 'usuario', contenido: texto, en: ahora });
        els.contenedor.appendChild(nodoUsuario);
        els.input.value = '';
        scrollFinal();

        try {
          const res = await enviarConCabeceraSegura(urlConConversacionId(`${API_BASE}/principal`), {
            method: 'POST',
            body: JSON.stringify({ texto }),
          });
          const j = await leerJson(res);
          if (!j.success) throw new Error(j.message || 'Error del servidor');

          const nodoDirector = crearNodoMensaje({
            rol: 'director',
            contenido: j.respuesta.textoClaro,
            en: j.respuesta.generadoEn || ahora,
            estado: j.respuesta.estado,
            categoria: j.respuesta.categoria,
            tipoIntencion: j.respuesta.tipoIntencion,
            naturalezaDatos: j.respuesta.naturalezaDatos,
            fuentes: j.respuesta.fuentes,
            tareas: j.respuesta.tareas,
            solicitudesAutorizacion: j.respuesta.solicitudesAutorizacion,
            limitaciones: j.respuesta.limitaciones,
            avisos: j.respuesta.avisos,
            controles: j.respuesta.controles,
            registrada: j.respuesta.registrada,
            generadoEn: j.respuesta.generadoEn,
          });
          els.contenedor.appendChild(nodoDirector);
          scrollFinal();
        } catch (err) {
          mostrarAlerta(err instanceof Error ? err.message : 'No se pudo enviar el mensaje.');
          if (nodoUsuario.parentNode) nodoUsuario.parentNode.removeChild(nodoUsuario);
        } finally {
          enVuelo = false;
          els.btnEnviar.disabled = false;
          els.input.disabled = false;
          els.input.focus();
        }
      }

      function mostrarAlerta(texto) {
        if (!els.alerta) return;
        els.alerta.hidden = !texto;
        if (texto) els.alerta.textContent = texto;
      }

      function fechaLegera(iso) {
        if (!iso) return '';
        try {
          const d = new Date(iso);
          return d.toLocaleString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        } catch { return iso; }
      }

      function fechaHora(iso) {
        if (!iso) return '';
        try {
          const d = new Date(iso);
          return d.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        } catch { return iso; }
      }

      function escapeHtml(texto) {
        return String(texto ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function scrollFinal() {
        if (els.contenedor) els.contenedor.scrollTop = els.contenedor.scrollHeight;
      }

      // ── eventos ──
      if (els.form) els.form.addEventListener('submit', enviarMensaje);
      if (els.input) {
        els.input.addEventListener('input', () => {
          els.btnEnviar.disabled = !els.input.value.trim() || enVuelo;
          mostrarAlerta(null);
        });
      }

      if (els.btnAdjuntar) {
        els.btnAdjuntar.addEventListener('click', () => {
          mostrarAlerta('Funciones adicionales pendientes (adjuntar contexto de ficha/categoría).');
        });
      }

      // ── voz: sesión continua tipo chat (Web Speech API del navegador, gratuita, sin servicios de pago) ──
      const Voz = (function () {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const SpeechSynthesis = window.speechSynthesis;
        const soportada = Boolean(SpeechRecognition && SpeechSynthesis);

        // Máquina de estados: INACTIVO -> ESCUCHANDO -> PROCESANDO -> HABLANDO -> ESCUCHANDO
        let estado = 'inactivo'; // inactivo | escuchando | procesando | hablando
        let sesionActiva = false;
        let reconocimiento = null;
        let sintetizando = false;
        let silenciado = false;
        let utteranceActual = null;
        let enVueloSesion = false; // bloquea nuevo envío mientras hay petición en curso
        let reconociendo = false;  // evita reconocimientos simultáneos y duplicados

        const elsVoz = {
          btn: document.getElementById('btnVoz'),
          btnDetener: document.getElementById('btnDetenerVoz'),
          textoBtn: document.getElementById('textoBtnVoz'),
          estado: document.getElementById('estadoVoz'),
          textoEstado: document.getElementById('textoEstadoVoz'),
          input: els.input,
          contenedor: els.contenedor,
        };

        function ponerEstadoVoz(texto, tipo = 'inactivo') {
          if (!elsVoz.estado || !elsVoz.textoEstado) return;
          elsVoz.textoEstado.textContent = texto;
          elsVoz.estado.hidden = false;
          const punto = elsVoz.estado.querySelector('.punto-voz');
          if (punto) punto.className = 'punto-voz punto-voz--' + tipo;
        }

        function ocultarEstadoVoz() {
          if (elsVoz.estado) elsVoz.estado.hidden = true;
        }

        function actualizarBotones() {
          // El botón Hablar/Finalizar solo se desactiva mientras se procesa o habla,
          // NO mientras se escucha (así se puede finalizar la sesión en cualquier momento).
          const ocupado = estado === 'procesando' || estado === 'hablando';
          if (elsVoz.btn) {
            // Con la sesión activa el botón es «Finalizar sesión» y debe poder pulsarse SIEMPRE
            // (también mientras el Director procesa o habla).
            elsVoz.btn.disabled = ocupado && !sesionActiva;
            elsVoz.btn.setAttribute('aria-pressed', String(estado === 'escuchando'));
            if (elsVoz.textoBtn) elsVoz.textoBtn.textContent = sesionActiva ? 'Finalizar sesión' : 'Hablar';
          }
          if (elsVoz.btnDetener) elsVoz.btnDetener.hidden = !sesionActiva;
          if (elsVoz.input) elsVoz.input.disabled = ocupado || enVuelo;
          if (els.btnEnviar) els.btnEnviar.disabled = ocupado || enVuelo || !elsVoz.input.value.trim();
        }

        function detenerReconocimiento() {
          reconociendo = false;
          if (reconocimiento) {
            try { reconocimiento.stop(); } catch { /* ignorar */ }
            reconocimiento = null;
          }
        }

        function cancelarSíntesis() {
          if (SpeechSynthesis) {
            try { SpeechSynthesis.cancel(); } catch { /* ignorar */ }
          }
          sintetizando = false;
          utteranceActual = null;
        }

        function finalizarSesion() {
          sesionActiva = false;
          estado = 'inactivo';
          detenerReconocimiento();
          cancelarSíntesis();
          ocultarEstadoVoz();
          actualizarBotones();
          if (elsVoz.input) elsVoz.input.disabled = enVuelo;
          if (els.btnEnviar) els.btnEnviar.disabled = enVuelo || !elsVoz.input.value.trim();
          mostrarAlerta(null);
        }

        function hablarTexto(texto) {
          if (!SpeechSynthesis || silenciado) {
            // No hay síntesis o está silenciado: volver a escuchar directamente.
            if (sesionActiva) reanudarEscucha();
            return;
          }
          cancelarSíntesis();
          sintetizando = true;
          estado = 'hablando';
          actualizarBotones();
          ponerEstadoVoz('El Director responde…', 'hablando');
          utteranceActual = new SpeechSynthesisUtterance(texto);
          utteranceActual.lang = 'es-ES';
          utteranceActual.onend = () => {
            sintetizando = false;
            utteranceActual = null;
            actualizarBotones();
            ocultarEstadoVoz();
            if (sesionActiva) reanudarEscucha();
          };
          utteranceActual.onerror = () => {
            sintetizando = false;
            utteranceActual = null;
            actualizarBotones();
            ocultarEstadoVoz();
            if (sesionActiva) reanudarEscucha();
          };
          try { SpeechSynthesis.speak(utteranceActual); } catch {
            sintetizando = false;
            actualizarBotones();
            ocultarEstadoVoz();
            if (sesionActiva) reanudarEscucha();
          }
        }

        function reanudarEscucha() {
          if (!sesionActiva) return;
          estado = 'escuchando';
          actualizarBotones();
          ponerEstadoVoz('Escuchando…', 'escuchando');
          iniciarReconocimientoInterno();
        }

        function iniciarReconocimientoInterno() {
          if (!soportada || !SpeechRecognition) {
            mostrarAlerta('Tu navegador no soporta reconocimiento de voz. Usa el teclado.');
            if (sesionActiva) finalizarSesion();
            return;
          }
          if (reconociendo) return; // evita reconocimientos simultáneos
          detenerReconocimiento();
          reconociendo = true;
          reconocimiento = new SpeechRecognition();
          reconocimiento.lang = 'es-ES';
          reconocimiento.continuous = true;
          reconocimiento.interimResults = false;
          reconocimiento.maxAlternatives = 1;

          reconocimiento.onresult = (evento) => {
            if (!sesionActiva) return; // ignora resultados si la sesión ya terminó
            const transcripcion = evento.results[evento.results.length - 1][0].transcript;
            const confianza = evento.results[evento.results.length - 1][0].confidence ?? 0;
            if (!transcripcion || !transcripcion.trim()) return;
            detenerReconocimiento();
            estado = 'procesando';
            actualizarBotones();
            ponerEstadoVoz('Procesando…', 'procesando');
            enviarMensajeSesion(transcripcion.trim(), confianza);
          };

          reconocimiento.onend = () => {
            reconocimiento = null;
            reconociendo = false;
            // Si terminó por sí solo (pausa natural) y la sesión sigue activa, volver a escuchar.
            if (sesionActiva && estado === 'escuchando') {
              reanudarEscucha();
            }
          };

          reconocimiento.onerror = (evento) => {
            reconocimiento = null;
            reconociendo = false;
            if (evento.error === 'not-allowed' || evento.error === 'service-not-allowed') {
              mostrarAlerta('Permiso del micrófono denegado. Concede acceso al micrófono o usa el teclado.');
              if (sesionActiva) finalizarSesion();
              return;
            }
            if (evento.error === 'no-speech') {
              if (sesionActiva) reanudarEscucha();
              return;
            }
            mostrarAlerta('Error de reconocimiento de voz.');
            if (sesionActiva) finalizarSesion();
          };

          try { reconocimiento.start(); } catch (e) {
            console.error('No se pudo iniciar reconocimiento:', e);
            mostrarAlerta('No se pudo iniciar el micrófono.');
            if (sesionActiva) finalizarSesion();
          }
        }

        async function enviarMensajeSesion(texto, confianza) {
          if (enVueloSesion) return;
          enVueloSesion = true;
          els.input.disabled = true;

          const ahora = new Date().toISOString();
          const nodoUsuario = crearNodoMensaje({ rol: 'usuario', contenido: texto, en: ahora });
          els.contenedor.appendChild(nodoUsuario);
          scrollFinal();

          try {
            const res = await enviarConCabeceraSegura(urlConConversacionId(`${API_BASE}/principal`), {
              method: 'POST',
              body: JSON.stringify({ texto, origen: 'voz', confianza }),
            });
            const j = await leerJson(res);
            if (!j.success) throw new Error(j.message || 'Error del servidor');

            const nodoDirector = crearNodoMensaje({
              rol: 'director',
              contenido: j.respuesta.textoClaro,
              en: j.respuesta.generadoEn || ahora,
              estado: j.respuesta.estado,
              categoria: j.respuesta.categoria,
              tipoIntencion: j.respuesta.tipoIntencion,
              naturalezaDatos: j.respuesta.naturalezaDatos,
              fuentes: j.respuesta.fuentes,
              tareas: j.respuesta.tareas,
              solicitudesAutorizacion: j.respuesta.solicitudesAutorizacion,
              limitaciones: j.respuesta.limitaciones,
              avisos: j.respuesta.avisos,
              controles: j.respuesta.controles,
              registrada: j.respuesta.registrada,
              generadoEn: j.respuesta.generadoEn,
            });
            els.contenedor.appendChild(nodoDirector);
            scrollFinal();

            // Una respuesta que llega después de finalizar la sesión se muestra, pero no se lee en voz
            // alta ni reactiva la escucha.
            const textoVoz = j.respuesta.detalle || j.respuesta.textoClaro;
            if (!sesionActiva) { /* sesión finalizada: nada más */ }
            else if (textoVoz) hablarTexto(textoVoz);
            else reanudarEscucha();
          } catch (err) {
            mostrarAlerta(err instanceof Error ? err.message : 'No se pudo enviar el mensaje.');
            if (sesionActiva) {
              enVueloSesion = false;
              els.input.disabled = false;
              reanudarEscucha();
            } else {
              enVueloSesion = false;
              els.input.disabled = false;
            }
          } finally {
            // Siempre liberar el candado de la sesión de voz al terminar el ciclo de petición.
            enVueloSesion = false;
            if (sesionActiva) {
              els.input.disabled = false;
            }
          }
        }

        // Interrupción del Director mientras habla: detiene la síntesis y vuelve a escuchar.
        // NO finaliza la sesión. Es un control diferenciado de «Finalizar sesión» (btnVoz).
        function interrumpirDirector() {
          if (!sesionActiva) return;
          cancelarSíntesis();
          estado = 'escuchando';
          actualizarBotones();
          ponerEstadoVoz('Escuchando…', 'escuchando');
          iniciarReconocimientoInterno();
        }

        return {
          soportada,
          silenciado: () => silenciado,
          setSilenciado: (v) => { silenciado = v; if (v) { cancelarSíntesis(); detenerReconocimiento(); } },
          iniciar: () => {
            if (sesionActiva) { finalizarSesion(); return; }
            if (!soportada) {
              mostrarAlerta('Tu navegador no soporta reconocimiento de voz. Usa el teclado.');
              return;
            }
            sesionActiva = true;
            estado = 'escuchando';
            actualizarBotones();
            ponerEstadoVoz('Escuchando…', 'escuchando');
            iniciarReconocimientoInterno();
          },
          detener: finalizarSesion,
          hablar: hablarTexto,
          interrumpir: interrumpirDirector,
        };
      })();

      // ── voz del Director (1.3.3): conversación hablada continua con la MISMA voz que Telegram ──
      // El micrófono se graba en el navegador; un detector de nivel decide cuándo empieza y termina cada intervención;
      // el audio va al Director por el servidor del panel (el token nunca llega aquí); vuelve su voz. Si la respuesta lleva
      // datos reales del negocio, el Director no la sintetiza fuera y la lee la voz local del navegador.
      // Hablar mientras el Director responde lo interrumpe (y se graba lo nuevo). Sin grabación o sin voz en el Director: voz del navegador.
      const VozDirector = (function () {
        const nav = window.navigator;
        const AC = window.AudioContext || window.webkitAudioContext;
        const disponible = Boolean(window.MediaRecorder && nav && nav.mediaDevices && typeof nav.mediaDevices.getUserMedia === 'function' && AC);
        const CFG = { umbral: 0.02, umbralRespuesta: 0.07, silencioFinMs: 900, minMs: 350, maxMs: 55000, interrupcionMs: 300, intervaloMs: 50 };
        let sesion = false; let estado = 'inactivo'; let noDisponible = false;
        let stream = null; let ctx = null; let analizador = null; let muestras = null; let reloj = null;
        let grabador = null; let trozos = []; let inicio = 0; let ultimaVoz = 0; let vozDesde = 0; let reproduccion = null; let turno = 0;
        const elsV = { btn: document.getElementById('btnVoz'), btnDetener: document.getElementById('btnDetenerVoz'), textoBtn: document.getElementById('textoBtnVoz'), estado: document.getElementById('estadoVoz'), textoEstado: document.getElementById('textoEstadoVoz') };

        function poner(nuevo, texto) {
          estado = nuevo;
          if (elsV.estado && elsV.textoEstado) {
            elsV.textoEstado.textContent = texto; elsV.estado.hidden = nuevo === 'inactivo';
            const p = elsV.estado.querySelector('.punto-voz'); if (p) p.className = 'punto-voz punto-voz--' + (nuevo === 'grabando' ? 'escuchando' : nuevo);
          }
          if (elsV.btn) { elsV.btn.disabled = false; elsV.btn.setAttribute('aria-pressed', String(sesion)); if (elsV.textoBtn) elsV.textoBtn.textContent = sesion ? 'Finalizar sesión' : 'Hablar'; }
          if (elsV.btnDetener) elsV.btnDetener.hidden = !sesion;
        }
        function nivel() { analizador.getFloatTimeDomainData(muestras); let s = 0; for (let i = 0; i < muestras.length; i += 1) s += muestras[i] * muestras[i]; return Math.sqrt(s / muestras.length); }
        function formato() {
          for (const t of ['audio/webm;codecs=opus', 'audio/ogg;codecs=opus', 'audio/webm', 'audio/mp4']) {
            try { if (typeof window.MediaRecorder.isTypeSupported !== 'function' || window.MediaRecorder.isTypeSupported(t)) return t; } catch { /* siguiente */ }
          }
          return '';
        }

        function vigilar() {
          if (!sesion || !analizador) return;
          const ahora = Date.now(); const n = nivel();
          if (estado === 'escuchando' || estado === 'procesando') { if (n > CFG.umbral) grabar(ahora); return; }
          if (estado === 'grabando') { if (n > CFG.umbral) ultimaVoz = ahora; if (ahora - ultimaVoz >= CFG.silencioFinMs || ahora - inicio >= CFG.maxMs) terminar(); return; }
          if (estado === 'hablando') {
            if (n > CFG.umbralRespuesta) { vozDesde = vozDesde || ahora; if (ahora - vozDesde >= CFG.interrupcionMs) { const desde = vozDesde; cortarRespuesta(); grabar(ahora, desde); } }
            else vozDesde = 0;
          }
        }

        /** `desde`: cuándo empezó a hablar (al interrumpir, la voz ya llevaba unos ms). */
        function grabar(ahora, desde = ahora) {
          if (estado === 'procesando') turno += 1; // hablar encima de una respuesta en camino la deja sin leer
          trozos = []; inicio = desde; ultimaVoz = ahora; vozDesde = 0;
          const tipo = formato();
          try { grabador = tipo ? new window.MediaRecorder(stream, { mimeType: tipo }) : new window.MediaRecorder(stream); } catch { grabador = new window.MediaRecorder(stream); }
          grabador.ondataavailable = (e) => { if (e.data && e.data.size) trozos.push(e.data); };
          grabador.onstop = () => procesarGrabacion(Date.now() - inicio, ultimaVoz - inicio);
          grabador.start();
          poner('grabando', 'Te escucho…');
        }
        function terminar() { if (grabador && grabador.state !== 'inactive') { poner('procesando', 'Procesando…'); try { grabador.stop(); } catch { /* ya parado */ } } }

        async function aBase64(blob) {
          const b = new Uint8Array(await blob.arrayBuffer()); let s = '';
          for (let i = 0; i < b.length; i += 0x8000) s += String.fromCharCode.apply(null, b.subarray(i, i + 0x8000));
          return window.btoa(s);
        }

        async function procesarGrabacion(duracionMs, hablaMs) {
          const r = grabador; grabador = null;
          if (!sesion) return;
          if (hablaMs < CFG.minMs || !trozos.length) { poner('escuchando', 'Escuchando…'); return; } // ruido, no una intervención
          const mio = (turno += 1);
          const mime = (r && r.mimeType) || (trozos[0] && trozos[0].type) || 'audio/webm';
          let j;
          try {
            const audio = await aBase64(new window.Blob(trozos, { type: mime }));
            const res = await enviarConCabeceraSegura(urlConConversacionId(`${API_BASE}/principal`), { method: 'POST', body: JSON.stringify({ audio, mime, segundos: Math.min(60, Math.max(0.5, duracionMs / 1000)) }) });
            j = await leerJson(res);
          } catch (e) {
            if (mio === turno && sesion) { mostrarAlerta(e instanceof Error ? e.message : 'No se pudo enviar tu voz.'); poner('escuchando', 'Escuchando…'); }
            return;
          }
          if (!j.success) {
            if (j.code === 'voz_no_disponible') { noDisponible = true; finalizar(); mostrarAlerta('La voz del Director no está activa en el servicio: uso la voz del navegador.'); Voz.iniciar(); return; }
            if (mio === turno && sesion) { mostrarAlerta(j.message || 'No se pudo procesar tu voz.'); poner('escuchando', 'Escuchando…'); }
            return;
          }
          const v = j.voz || {};
          if (v.transcripcion) els.contenedor.appendChild(crearNodoMensaje({ rol: 'usuario', contenido: v.transcripcion, en: new Date().toISOString() }));
          if (j.respuesta) {
            const a = j.respuesta;
            els.contenedor.appendChild(crearNodoMensaje({ rol: 'director', contenido: a.textoClaro, en: a.generadoEn, estado: a.estado, categoria: a.categoria, tipoIntencion: a.tipoIntencion, naturalezaDatos: a.naturalezaDatos, fuentes: a.fuentes, tareas: a.tareas, solicitudesAutorizacion: a.solicitudesAutorizacion, limitaciones: a.limitaciones, avisos: a.avisos, controles: a.controles, registrada: a.registrada, generadoEn: a.generadoEn }));
          }
          scrollFinal();
          if (mio !== turno || !sesion) return; // ya se habló encima o se cerró la sesión: se muestra, no se lee
          if (v.audio && v.audio.base64) { reproducir(`data:${v.audio.mime};base64,${v.audio.base64}`); return; }
          if (v.vozLocal) { hablarLocal(v.vozLocal); return; }
          if (v.mensaje) mostrarAlerta(v.mensaje);
          poner('escuchando', 'Escuchando…');
        }

        function reproducir(url) {
          poner('hablando', 'El Director responde…'); vozDesde = 0;
          const a = new window.Audio(url); reproduccion = a;
          const fin = () => { if (reproduccion === a) { reproduccion = null; if (sesion && estado === 'hablando') poner('escuchando', 'Escuchando…'); } };
          a.onended = fin; a.onerror = fin;
          try { const p = a.play(); if (p && typeof p.catch === 'function') p.catch(fin); } catch { fin(); }
        }
        function hablarLocal(texto) {
          const S = window.speechSynthesis;
          if (!S || !window.SpeechSynthesisUtterance) { poner('escuchando', 'Escuchando…'); return; }
          poner('hablando', 'El Director responde (voz local: datos del negocio)…'); vozDesde = 0;
          const u = new window.SpeechSynthesisUtterance(texto); u.lang = 'es-ES'; reproduccion = u;
          const fin = () => { if (reproduccion === u) { reproduccion = null; if (sesion && estado === 'hablando') poner('escuchando', 'Escuchando…'); } };
          u.onend = fin; u.onerror = fin;
          try { S.speak(u); } catch { fin(); }
        }
        function cortarRespuesta() {
          const r = reproduccion; reproduccion = null;
          if (r && typeof r.pause === 'function') { try { r.pause(); } catch { /* nada */ } }
          if (window.speechSynthesis) { try { window.speechSynthesis.cancel(); } catch { /* nada */ } }
        }

        async function iniciar() {
          if (sesion) { finalizar(); return; }
          try { stream = await nav.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } }); }
          catch { mostrarAlerta('Permiso del micrófono denegado. Concede acceso al micrófono o usa el teclado.'); return; }
          ctx = new AC(); const fuente = ctx.createMediaStreamSource(stream); analizador = ctx.createAnalyser(); analizador.fftSize = 2048; fuente.connect(analizador); muestras = new Float32Array(analizador.fftSize);
          sesion = true; turno += 1; poner('escuchando', 'Escuchando…'); mostrarAlerta(null);
          reloj = setInterval(vigilar, CFG.intervaloMs);
        }
        function finalizar() {
          sesion = false; turno += 1; cortarRespuesta();
          if (reloj) { clearInterval(reloj); reloj = null; }
          if (grabador && grabador.state !== 'inactive') { try { grabador.stop(); } catch { /* nada */ } }
          grabador = null;
          if (stream) { for (const t of stream.getTracks()) { try { t.stop(); } catch { /* nada */ } } stream = null; }
          if (ctx) { try { ctx.close(); } catch { /* nada */ } ctx = null; analizador = null; }
          poner('inactivo', '');
        }
        function interrumpir() { if (!sesion) return; cortarRespuesta(); if (estado === 'hablando') poner('escuchando', 'Escuchando…'); }

        return { disponible: () => disponible && !noDisponible, activa: () => sesion, estado: () => estado, iniciar, finalizar, interrumpir, _vigilar: vigilar };
      })();

      // eventos de voz
      // btnVoz: inicia la sesión (inactivo) o la finaliza inequívocamente (activa). Con grabación disponible se usa la voz del Director;
      // si no, la del navegador (Web Speech).
      if (els.btnVoz) els.btnVoz.addEventListener('click', () => {
        if (VozDirector.activa() || (VozDirector.disponible() && !Voz.silenciado())) { VozDirector.iniciar(); return; }
        if (!Voz.silenciado()) Voz.iniciar();
      });
      // btnDetenerVoz: interrumpe la respuesta del Director y vuelve a escuchar (no finaliza la sesión).
      if (els.btnDetenerVoz) els.btnDetenerVoz.addEventListener('click', () => { if (VozDirector.activa()) VozDirector.interrumpir(); else Voz.interrumpir(); });



      // ── configuración de conversación (compartir con Telegram) ──
      conversacionIdConfigurada = leerConversacionIdGuardada();
      if (els.inputConversacionId && conversacionIdConfigurada) {
        els.inputConversacionId.value = conversacionIdConfigurada;
      }
      if (els.btnConfigurarConversacion && els.panelConfiguracion) {
        els.btnConfigurarConversacion.addEventListener('click', () => {
          const hidden = els.panelConfiguracion.hidden;
          els.panelConfiguracion.hidden = !hidden;
          if (!hidden) els.inputConversacionId.focus();
        });
      }
      if (els.btnGuardarConversacionId && els.inputConversacionId) {
        els.btnGuardarConversacionId.addEventListener('click', () => {
          const id = els.inputConversacionId.value.trim();
          if (id && !/^cv_[0-9a-f]{16}$/.test(id)) {
            mostrarAlertaConversacionId('ID inválido: debe ser cv_ seguido de 16 caracteres hexadecimales.');
            return;
          }
          guardarConversacionId(id || null);
          mostrarAlertaConversacionId(id ? `Conversación configurada: ${id}` : 'Conversación limpiada (se creará una nueva).');
          setTimeout(() => mostrarAlertaConversacionId(null), 3000);
          els.panelConfiguracion.hidden = true;
          // Recargar la conversación con el nuevo ID
          cargarConversacionPrincipal();
        });
      }
      if (els.btnLimpiarConversacionId && els.inputConversacionId) {
        els.btnLimpiarConversacionId.addEventListener('click', () => {
          els.inputConversacionId.value = '';
          guardarConversacionId(null);
          mostrarAlertaConversacionId('Conversación limpiada.');
          setTimeout(() => mostrarAlertaConversacionId(null), 3000);
          els.panelConfiguracion.hidden = true;
          cargarConversacionPrincipal();
        });
      }

      // iniciar
      // ── confirmaciones pendientes (opción A: reautenticación con contraseña; el token de confirmar NUNCA llega aquí) ──
      async function cargarConfirmaciones() {
        const sec = document.getElementById('confirmacionesPendientes'); const lista = document.getElementById('listaConfirmaciones');
        if (!sec || !lista) return;
        try {
          const res = await fetch(`${API_BASE}/panel`, { headers: { 'cache-control': 'no-store' } }); const j = await leerJson(res);
          const pend = (j && j.success && Array.isArray(j.confirmacionesPendientes)) ? j.confirmacionesPendientes : [];
          lista.textContent = ''; sec.hidden = pend.length === 0;
          for (const c of pend) {
            const fila = document.createElement('div'); fila.className = 'director-ia-confirmacion';
            const t = document.createElement('div'); t.textContent = `${String(c.tipo || '').replace(/_/g, ' ')} · caduca ${c.caduca ? new Date(c.caduca).toLocaleTimeString('es-ES') : '—'}`; fila.appendChild(t);
            const clave = document.createElement('input'); clave.type = 'password'; clave.placeholder = 'Tu contraseña'; clave.autocomplete = 'current-password'; fila.appendChild(clave);
            const aviso = document.createElement('div'); aviso.className = 'director-ia-alerta'; aviso.hidden = true;
            for (const decision of ['confirmar', 'rechazar']) {
              const b = document.createElement('button'); b.type = 'button'; b.className = decision === 'confirmar' ? 'btn-primary btn-sm' : 'btn-secondary btn-sm'; b.textContent = decision === 'confirmar' ? 'Confirmar' : 'Rechazar';
              b.addEventListener('click', async () => {
                if (!clave.value) { aviso.hidden = false; aviso.textContent = 'Escribe tu contraseña.'; return; }
                b.disabled = true;
                try {
                  const r = await enviarConCabeceraSegura(`${API_BASE}/confirmar`, { method: 'POST', body: JSON.stringify({ idConfirmacion: c.idConfirmacion, decision, password: clave.value }) });
                  const jr = await leerJson(r); clave.value = '';
                  aviso.hidden = false; aviso.textContent = jr.success ? (decision === 'confirmar' ? 'Confirmado y aplicado por el Director.' : 'Rechazado.') : (jr.message || 'No se pudo completar.');
                  if (jr.success) setTimeout(() => { cargarConfirmaciones(); cargarConversacionPrincipal(); }, 800);
                } catch (e) { aviso.hidden = false; aviso.textContent = e instanceof Error ? e.message : 'No se pudo completar.'; } finally { b.disabled = false; }
              });
              fila.appendChild(b);
            }
            fila.appendChild(aviso); lista.appendChild(fila);
          }
        } catch { /* sin panel: la sección queda oculta */ }
      }
      cargarConfirmaciones(); setInterval(cargarConfirmaciones, 60000);
      if (els.contenedor && typeof MutationObserver === 'function') new MutationObserver(() => cargarConfirmaciones()).observe(els.contenedor, { childList: true });

      comprobarEstado();
      cargarConversacionPrincipal();
      setInterval(comprobarEstado, 60000);
    })();
  </script>

  <style>
    .director-ia-page {
