    .director-ia-adjunto .estado { opacity: 0.7; }
    .director-ia-adjunto--error { border-color: #f87171; }
    .director-ia-adjunto button { background: transparent; border: 0; color: inherit; cursor: pointer; font-size: 0.9rem; }
    .director-ia-alerta { margin-top: 0.5rem; font-size: 0.82rem; color: #fca5a5; padding: 0.5rem 0.8rem; border: 1px solid rgba(248, 113, 113, 0.25); border-radius: 12px; background: rgba(248, 113, 113, 0.07); max-height: 6rem; overflow-y: auto; }
    .director-ia-estado-voz { display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem; border-radius: 999px; font-size: 0.8rem; border: 1px solid var(--di-borde); background: #111a2b; align-self: center; }
    .director-ia-estado-voz .punto-voz { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .director-ia-page .punto-voz--escuchando { background: var(--di-acento); box-shadow: 0 0 6px var(--di-acento); animation: director-ia-pulso-voz 1.5s infinite; }
