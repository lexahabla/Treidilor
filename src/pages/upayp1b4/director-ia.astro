    /* mensajes: los del usuario en burbuja a la derecha; las respuestas del Director sin burbuja, a todo el ancho de lectura (como ChatGPT).
       La hora, el remitente y los metadatos técnicos van en una línea discreta junto a las acciones, visible al pasar el ratón o al enfocarla. */
    .director-ia-burbuja { position: relative; display: flex; flex-wrap: wrap; align-items: center; column-gap: 0.5rem; width: 100%; font-size: 1rem; line-height: 1.75; overflow-wrap: anywhere; animation: director-ia-entra 0.18s ease-out; }
    .director-ia-burbuja > * { flex: 1 1 100%; min-width: 0; }
    .director-ia-burbuja > .director-ia-burbuja-cabecera { order: 10; flex: 0 1 auto; }
    .director-ia-burbuja > .director-ia-burbuja-acciones { order: 11; flex: 0 0 auto; }
    .director-ia-burbuja > .btn-secondary { order: 12; flex: 0 0 auto; margin-top: 0.4rem; }
    .director-ia-burbuja--director { color: var(--di-texto); }
    .director-ia-burbuja--usuario { justify-content: flex-end; margin-left: auto; max-width: min(70%, 36rem); }
    .director-ia-burbuja--usuario > .director-ia-burbuja-cuerpo { flex: 0 1 auto; max-width: 100%; background: var(--di-burbuja); border-radius: 1.4rem; padding: 0.55rem 1.1rem; }
    .director-ia-burbuja--usuario > .director-ia-burbuja-adjuntos { justify-content: flex-end; }
    /* salto de línea: la burbuja va sola a la derecha y la hora y las acciones, debajo (si no, compartirían su fila y la desplazarían) */
    .director-ia-burbuja::after { content: ''; order: 9; flex: 1 1 100%; height: 0; }
    .director-ia-burbuja--error > .director-ia-burbuja-cuerpo { outline: 1px dashed #f87171; }
    .director-ia-burbuja-cabecera { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.45rem; margin-top: 0.3rem; font-size: 0.75rem; font-weight: 500; color: var(--di-suave); line-height: 1.4; }
    .director-ia-burbuja-hora { font-weight: 400; }
    .director-ia-meta { font-size: 0.72rem; font-weight: 400; opacity: 0.8; }
    .director-ia-burbuja > .director-ia-burbuja-cabecera, .director-ia-burbuja > .director-ia-burbuja-acciones { opacity: 0; transition: opacity 0.15s ease; }
    .director-ia-burbuja:hover > .director-ia-burbuja-cabecera, .director-ia-burbuja:hover > .director-ia-burbuja-acciones, .director-ia-burbuja:focus-within > .director-ia-burbuja-cabecera, .director-ia-burbuja:focus-within > .director-ia-burbuja-acciones { opacity: 1; }
    @media (hover: none) { .director-ia-burbuja > .director-ia-burbuja-cabecera, .director-ia-burbuja > .director-ia-burbuja-acciones { opacity: 0.7; } }
    .director-ia-burbuja-cuerpo { white-space: pre-wrap; overflow-wrap: anywhere; }
    .director-ia-burbuja-cuerpo.md { white-space: normal; }
    .director-ia-burbuja-cuerpo a { color: #7cb4ff; text-decoration: underline; text-underline-offset: 2px; }
    .director-ia-burbuja-cuerpo.md > :first-child { margin-top: 0; }
    .director-ia-burbuja-cuerpo.md p { margin: 0 0 0.9rem; }
    .director-ia-burbuja-cuerpo.md p:last-child, .director-ia-burbuja-cuerpo.md > :last-child { margin-bottom: 0; }
    .director-ia-burbuja-cuerpo.md h1, .director-ia-burbuja-cuerpo.md h2, .director-ia-burbuja-cuerpo.md h3, .director-ia-burbuja-cuerpo.md h4 { margin: 1.4rem 0 0.6rem; line-height: 1.35; font-weight: 600; color: var(--di-texto); }
    .director-ia-burbuja-cuerpo.md h1 { font-size: 1.5rem; } .director-ia-burbuja-cuerpo.md h2 { font-size: 1.3rem; } .director-ia-burbuja-cuerpo.md h3 { font-size: 1.15rem; } .director-ia-burbuja-cuerpo.md h4 { font-size: 1rem; }
    .director-ia-burbuja-cuerpo.md strong { font-weight: 600; color: #fff; }
