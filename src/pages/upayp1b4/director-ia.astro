    .director-ia-burbuja-cuerpo.md code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875em; }
    .director-ia-burbuja-cuerpo.md :not(pre) > code { padding: 0.1rem 0.35rem; border-radius: 6px; background: rgba(148, 163, 184, 0.16); }
    .director-ia-burbuja-cuerpo.md table { border-collapse: collapse; display: block; overflow-x: auto; margin: 0.6rem 0 1rem; max-width: 100%; font-size: 0.9rem; line-height: 1.5; }
    .director-ia-burbuja-cuerpo.md th, .director-ia-burbuja-cuerpo.md td { border-bottom: 1px solid var(--di-borde); padding: 0.45rem 0.75rem; text-align: left; overflow-wrap: normal; word-break: normal; } /* sin partir palabras: la tabla se desplaza en horizontal */
    .director-ia-burbuja-cuerpo.md th { font-weight: 600; border-bottom-color: #334155; }
    .director-ia-burbuja-cuerpo.md ul, .director-ia-burbuja-cuerpo.md ol { margin: 0.2rem 0 0.9rem 1.4rem; padding: 0; }
    .director-ia-burbuja-cuerpo.md li { margin: 0.2rem 0; }
    .director-ia-burbuja-cuerpo.md blockquote { margin: 0.6rem 0; padding-left: 0.9rem; border-left: 3px solid #334155; color: var(--di-suave); }
    .director-ia-burbuja-cuerpo.md hr { border: 0; border-top: 1px solid var(--di-borde); margin: 1.2rem 0; }
    .director-ia-burbuja-acciones { display: inline-flex; gap: 0.15rem; margin-top: 0.3rem; }
    .director-ia-burbuja-acciones button { font: inherit; font-size: 0.75rem; background: transparent; border: 0; border-radius: 8px; padding: 0.2rem 0.5rem; color: var(--di-suave); cursor: pointer; }
    .director-ia-burbuja-acciones button:hover { background: var(--di-hover); color: var(--di-texto); }
    /* informes, fuentes, tareas y autorizaciones del Director: tarjetas discretas dentro de la respuesta, con su trazabilidad */
    .director-ia-dato, .director-ia-fuentes, .director-ia-tareas, .director-ia-auth, .director-ia-limites, .director-ia-avisos { margin-top: 0.75rem; padding: 0.6rem 0.85rem; border-radius: 12px; font-size: 0.85rem; line-height: 1.5; border: 1px solid var(--di-borde); background: #111a2b; color: var(--di-suave); }
    .director-ia-dato { border-left: 3px solid #6366f1; }
    .director-ia-fuentes { border-left: 3px solid #10b981; }
    .director-ia-tareas { border-left: 3px solid #3b82f6; }
    .director-ia-auth { border-left: 3px solid #ca8a04; color: #fde68a; }
    .director-ia-limites, .director-ia-avisos { border-left: 3px solid #f87171; color: #fecaca; }
    .director-ia-burbuja-adjuntos { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
    .director-ia-burbuja-adjuntos img { max-width: 240px; max-height: 180px; border-radius: 12px; display: block; }
    .director-ia-burbuja-adjuntos a { font-size: 0.85rem; color: var(--di-texto); padding: 0.45rem 0.7rem; border: 1px solid var(--di-borde); border-radius: 12px; text-decoration: none; }
    @keyframes director-ia-entra { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

    /* ── editor anclado abajo (no forma parte del scroll): como el de ChatGPT ── */
    .director-ia-form {
      flex: none;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin: 0;
      padding: 0 max(0.75rem, calc((100% - var(--di-ancho-hilo)) / 2)) max(0.5rem, env(safe-area-inset-bottom));
      background: var(--di-fondo);
    }
    .director-ia-form > .director-ia-alerta { order: 1; margin: 0; }
    .director-ia-form > .director-ia-estado-voz { order: 2; }
    .director-ia-form > .director-ia-adjuntos { order: 3; }
    .director-ia-form > .director-ia-input-wrap { order: 4; }
    .director-ia-form > .director-ia-aviso-pie { order: 5; }
    .director-ia-input-wrap {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem;
      padding: 0.6rem 0.6rem 0.55rem;
      border: 1px solid #26324a;
      border-radius: 28px;
      background: var(--di-editor);
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
      cursor: text;
    }
    .director-ia-input-wrap:focus-within { border-color: #36476a; }
    #inputMensaje {
      order: 0;
      flex: 1 1 100%;
      min-width: 0;
      resize: none;
      border: 0;
      outline: none;
      background: transparent;
      color: var(--di-texto);
      font: inherit;
      font-size: 1rem;
      line-height: 1.5;
      min-height: 2.25rem;
      max-height: min(12rem, 30vh);
      overflow-y: auto;
      padding: 0.3rem 0.65rem 0.4rem;
      scrollbar-width: thin;
    }
    #inputMensaje::placeholder { color: var(--di-suave); }
    #inputMensaje:disabled { opacity: 0.6; }
    #btnAdjuntar { order: 1; }
    #modoVoz { order: 2; }
    #vozElegida { order: 2; max-width: 9.5rem; }
    #btnMuestraVoz { order: 2; }
    #btnMuestraVoz .muestra-stop, #btnMuestraVoz.sonando .muestra-play { display: none; }
    #btnMuestraVoz.sonando .muestra-stop { display: block; }
    #btnMuestraVoz.sonando { color: var(--di-texto); background: var(--di-activo); }
    #btnAltavoz { order: 2; margin-right: auto; }
    .director-ia-altavoz .altavoz-si { display: none; }
    .director-ia-altavoz.activo .altavoz-si { display: block; }
    .director-ia-altavoz.activo .altavoz-no { display: none; }
    .director-ia-altavoz.activo { color: var(--di-texto); }
    .director-ia-altavoz.sin-cupo { position: relative; }
    .director-ia-altavoz.sin-cupo::after { content: ''; position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border-radius: 50%; background: #f59e0b; box-shadow: 0 0 5px #f59e0b; }
    #btnDetenerVoz { order: 3; }
    #btnVoz { order: 4; }
    #btnEnviar { order: 5; }
    /* conversación por voz: círculo claro con ondas (como el de ChatGPT); al escribir se sustituye por el botón de enviar */
    .director-ia-voz, .director-ia-enviar { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; flex: none; height: 36px; min-width: 36px; padding: 0; border: 0; border-radius: 999px; background: #ececf1; color: #0d1424; font: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: background-color 0.15s ease, opacity 0.15s ease; }
    .director-ia-voz:hover:not(:disabled), .director-ia-enviar:hover:not(:disabled) { background: #fff; }
    .director-ia-voz:disabled { opacity: 0.35; cursor: not-allowed; }
    .director-ia-enviar:disabled { background: #3a465c; color: #8090a8; cursor: default; }
    .director-ia-voz .texto-btn-voz { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .director-ia-voz.en-sesion { padding: 0 0.9rem 0 0.7rem; background: var(--di-acento); color: #fff; }
    .director-ia-voz.en-sesion:hover:not(:disabled) { background: #2563eb; }
    .director-ia-voz.en-sesion .texto-btn-voz { position: static; width: auto; height: auto; clip: auto; overflow: visible; }
    .director-ia-voz[aria-pressed="true"] .director-ia-ondas line { animation: director-ia-onda 1s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
    .director-ia-voz[aria-pressed="true"] .director-ia-ondas .o2 { animation-delay: 0.15s; } .director-ia-voz[aria-pressed="true"] .director-ia-ondas .o3 { animation-delay: 0.3s; }
    .director-ia-voz[aria-pressed="true"] .director-ia-ondas .o4 { animation-delay: 0.45s; } .director-ia-voz[aria-pressed="true"] .director-ia-ondas .o5 { animation-delay: 0.6s; }
    @keyframes director-ia-onda { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.45); } }
    /* con texto escrito: «enviar»; sin texto: «voz» (salvo en plena sesión de voz, que siempre se puede finalizar) */
    .director-ia-input-wrap:has(#btnEnviar:disabled) #btnEnviar { display: none; }
    .director-ia-input-wrap:has(#btnEnviar:not(:disabled)) #btnVoz:not(.en-sesion) { display: none; }
    .director-ia-modo-voz { height: 32px; font: inherit; font-size: 0.8rem; padding: 0 0.6rem; border-radius: 999px; border: 1px solid var(--di-borde); background: transparent; color: var(--di-suave); max-width: 10rem; cursor: pointer; }
    .director-ia-modo-voz:hover { color: var(--di-texto); background: var(--di-hover); }
    .director-ia-modo-voz option { background: #111827; color: var(--di-texto); }
    .director-ia-aviso-pie { margin: 0; padding: 0.15rem 0 0; text-align: center; font-size: 0.72rem; color: var(--di-suave); }
    .director-ia-adjuntos { display: flex; flex-wrap: wrap; gap: 0.4rem; max-height: 6.5rem; overflow-y: auto; }
    .director-ia-adjunto { display: flex; align-items: center; gap: 0.45rem; border: 1px solid var(--di-borde); border-radius: 12px; padding: 0.3rem 0.5rem; font-size: 0.8rem; max-width: 18rem; background: var(--di-editor); }
    .director-ia-adjunto img { width: 38px; height: 38px; object-fit: cover; border-radius: 8px; }
