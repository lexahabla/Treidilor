    .director-ia-hilo { position: relative; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .director-ia-mensajes {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      overflow-anchor: none; /* la posición al cargar «anteriores» la conserva el script; el anclaje del navegador la duplicaría */
      scroll-behavior: auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      /* columna de lectura centrada (como ChatGPT) con la barra de desplazamiento pegada al borde */
      padding: 1.5rem max(1rem, calc((100% - var(--di-ancho-hilo)) / 2)) 2rem;
      scrollbar-width: thin;
      scrollbar-color: rgba(148, 163, 184, 0.25) transparent;
    }
    .director-ia-vacio, .director-ia-vacio-centrado, .director-ia-error, .director-ia-cargando { text-align: center; color: var(--di-suave); font-size: 0.875rem; padding: 1rem; }
    .director-ia-vacio-centrado { display: flex; align-items: center; justify-content: center; flex: 1; font-size: 1.6rem; font-weight: 500; color: var(--di-texto); line-height: 1.35; padding: 1rem 0.5rem; }
    .director-ia-lista .director-ia-vacio { font-size: 0.8rem; padding: 0.4rem 0.6rem; text-align: left; }
    .director-ia-error { color: #fca5a5; font-size: 0.875rem; padding: 0.9rem 1rem; border: 1px solid rgba(248, 113, 113, 0.25); border-radius: 14px; background: rgba(248, 113, 113, 0.06); }
    .director-ia-error .director-ia-reintentar { display: block; margin: 0.6rem auto 0; }
    .director-ia-cargar-anteriores { display: block; align-self: center; margin: 0 auto 0.25rem; font-size: 0.8rem; }
    .director-ia-ir-final {
      position: absolute;
      left: 50%;
      bottom: 0.75rem;
      transform: translateX(-50%);
      z-index: 5;
      display: inline-flex;
