            alEmpezar: () => { try { console.info('[voz-rapida]', JSON.stringify({ primerSonidoMs: Date.now() - tResultado })); } catch { /* sin consola */ } },
            alTerminar: (m) => { Altavoz.reproduccion(m); estado = 'escuchando'; actualizarBotones(); ocultarEstadoVoz(); if (sesionActiva) reanudarEscucha(); },
          });
        }

        async function enviarMensajeSesion(texto, confianza) {
