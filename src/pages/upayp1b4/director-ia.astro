          if (fs.length) { e.preventDefault(); anadir(fs.map((f, i) => (f.name && f.name !== 'image.png' ? f : new File([f], `captura-${new Date().toISOString().slice(11, 19).replace(/:/g, '')}-${i + 1}.png`, { type: f.type })))); }
        });
        return { anadir, vaciar, listos: () => items.filter((x) => x.estado === 'listo').map(({ id, nombre, tipo }) => ({ id, nombre, tipo })), subiendo: () => items.some((x) => x.estado === 'subiendo'), _items: () => items };
      })();

      // ── voz: sesión continua tipo chat (Web Speech API del navegador, gratuita, sin servicios de pago) ──
      // ── RESPUESTAS HABLADAS: preferencia EXPLÍCITA del propietario, DESACTIVADA por defecto y guardada en este navegador (vale para todos los chats
      // y sobrevive a la recarga). Desactivada: el Director responde solo por escrito, también en una conversación por voz (el micrófono sigue
      // funcionando: tu voz se transcribe). Nunca se sustituye la voz natural del Director por la voz sintética del navegador: esa solo suena si
      // la activas Y eliges «Voz rápida (del navegador)». Independiente de Telegram.
      const modoVozActual = () => { try { return localStorage.getItem('directorIA.modoVoz') === 'rapida' ? 'rapida' : 'director'; } catch { return 'director'; } };
      // Voz local del Director (Kokoro en la propia VPS, sin cupo): lista cerrada; se recuerda en este navegador y se cambia sin redespliegue.
      const VOCES_DIRECTOR = ['alex', 'dora', 'santa'];
      const vozElegidaActual = () => { try { const v = localStorage.getItem('directorIA.voz'); return VOCES_DIRECTOR.includes(v) ? v : 'alex'; } catch { return 'alex'; } };
      const Altavoz = (function () {
        const CLAVE = 'directorIA.respuestasHabladas'; const b = document.getElementById('btnAltavoz'); const avisos = [];
        // ACTIVADO por defecto desde que el Director tiene voz local sin cupo (1.3.7); si alguna vez lo desactivaste, se respeta tu elección guardada
        let activo = true; try { const g = window.localStorage ? localStorage.getItem(CLAVE) : null; activo = g === null || g === undefined ? true : g === 'si'; } catch { activo = true; }
        function pintar() {
          if (!b) return;
