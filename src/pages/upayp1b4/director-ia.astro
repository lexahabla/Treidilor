---
/**
 * TREIDILOR — /upayp1b4/director-ia  (apartado «Director IA» del panel).
 *
 * Chat conversacional con el Director 00 a través del puente persistente
 * (Canal 13). Reusa AdminNav, autenticación administrativa, estilos del
 * panel y el almacén persistente de conversaciones.
 *
 * La conversación del Director es ÚNICA y COMPARTIDA con Telegram
 * (conversación principal, fuente de verdad del historial). El panel no
 * crea conversaciones independientes ni permite eliminar el historial
 * compartido por error.
 */
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminSectionHeader from '../../components/admin/AdminSectionHeader.astro';
import AdminUserMenu from '../../components/AdminUserMenu.astro';
import { getSessionUser } from '../../lib/adminAuth';

const sessionUser = getSessionUser(Astro.request);
if (!sessionUser) return Astro.redirect('/upayp1b4');
if (!sessionUser.master) return Astro.redirect('/upayp1b4/perfil');

Astro.response.headers.set('Cache-Control', 'no-store');

const activeSection = 'director-ia';
---

<Layout title="Director IA | Panel Treidilor" description="Conversa con el Director IA de Treidilor (Agente 00). Historial persistente compartido con Telegram.">
  <Fragment slot="header-end">
    <AdminUserMenu user={sessionUser} active={activeSection} />
  </Fragment>
  <div class="admin-wrapper">
    <AdminSectionHeader
      eyebrow="Director IA"
      titulo="Asistente conversacional"
      subtitle="Habla con el Director 00 en lenguaje natural. El historial se guarda en el servidor y se recupera al volver."
      ids={{ eyebrow: 'directorIaHeaderPill', title: 'directorIaHeaderTitle', subtitle: 'directorIaHeaderSubtitle' }}
    />
    <AdminNav context="catalogo" active={activeSection} user={sessionUser} />

    <main class="director-ia-page">
      <aside class="director-ia-sidebar" id="barraChats" aria-label="Chats del Director">
        <div class="director-ia-sidebar-head director-ia-sidebar-acciones">
          <button type="button" id="btnNuevoChat" class="btn-primary btn-sm" title="Nuevo chat (Alt+N)">＋ Nuevo chat</button>
          <button type="button" id="btnNuevoProyecto" class="btn-secondary btn-sm" title="Nuevo proyecto o carpeta">＋ Proyecto</button>
        </div>
        <input type="search" id="buscarChats" class="director-ia-buscar" placeholder="Buscar chats… (Ctrl+K)" aria-label="Buscar chats" autocomplete="off" />
        <div class="director-ia-vistas" role="tablist" aria-label="Vista de chats">
          <button type="button" role="tab" class="director-ia-vista" data-vista="activos" aria-selected="true">Chats</button>
          <button type="button" role="tab" class="director-ia-vista" data-vista="archivados" aria-selected="false">Archivados</button>
          <button type="button" role="tab" class="director-ia-vista" data-vista="papelera" aria-selected="false">Papelera</button>
        </div>
        <nav id="listaChats" class="director-ia-lista" aria-label="Lista de chats"></nav>
        <div id="listaConversaciones" hidden></div>
        <div id="estadoConexion" class="director-ia-estado" role="status" aria-live="polite">
          <span class="punto punto--desconectado" aria-hidden="true"></span>
          <span id="textoEstado">Comprobando conexión…</span>
        </div>
        <div class="director-ia-config" aria-label="Configuración de conversación">
          <button type="button" id="btnConfigurarConversacion" class="btn-secondary btn-sm" title="Configurar ID de conversación (para compartir con Telegram)">🔗</button>
          <div id="panelConfiguracion" class="director-ia-config-panel" hidden>
            <label class="director-ia-config-label">ID de conversación (Telegram / panel):</label>
            <input type="text" id="inputConversacionId" placeholder="cv_..." maxlength="64" spellcheck="false" />
            <button type="button" id="btnGuardarConversacionId" class="btn-primary btn-sm">Guardar</button>
            <button type="button" id="btnLimpiarConversacionId" class="btn-secondary btn-sm" style="margin-left:0.4rem">Limpiar</button>
            <div id="alertaConversacionId" class="director-ia-alerta" hidden role="alert" aria-live="assertive"></div>
          </div>
        </div>
      </aside>

      <section class="director-ia-chat" aria-label="Chat">
        <div class="director-ia-chat-header">
          <button type="button" id="btnBarraChats" class="director-ia-btn-barra" aria-controls="barraChats" aria-expanded="false" title="Chats">☰</button>
          <h1 id="tituloConversacion">Director IA</h1>
          <p id="subtituloConversacion" class="director-ia-chat-sub">Conversación principal compartida con Telegram.</p>
          <section id="confirmacionesPendientes" class="director-ia-confirmaciones" hidden aria-live="polite">
            <h2>Confirmaciones pendientes</h2>
            <p class="director-ia-chat-sub">Operaciones que el Director solo aplica con tu confirmación. Se te pedirá la contraseña.</p>
            <div id="listaConfirmaciones"></div>
          </section>
        </div>

        <div class="director-ia-mensajes" id="contenedorMensajes" role="log" aria-live="polite">
          <div class="director-ia-vacio-centrado">Selecciona o crea una conversación para empezar a hablar con el Director.</div>
        </div>

        <button type="button" id="btnIrAlFinal" class="director-ia-ir-final" hidden>↓ Mensajes nuevos</button>
        <form id="formMensaje" class="director-ia-form">
          <div class="director-ia-input-wrap">
            <textarea
              id="inputMensaje"
              rows="1"
              placeholder="Escribe al Director… (Enter envía, Mayús+Enter salto de línea)"
              aria-label="Mensaje al Director IA"
              autocomplete="off"
              spellcheck="true"
              maxlength="2000"
            ></textarea>
            <button type="button" id="btnVoz" class="btn-secondary btn-sm" title="Hablar con el Director (micrófono)" aria-pressed="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3Z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="23"></line>
                <line x1="8" y1="23" x2="16" y2="23"></line>
              </svg>
              <span id="textoBtnVoz" class="texto-btn-voz">Hablar</span>
            </button>
            <select id="modoVoz" class="director-ia-modo-voz" title="Modo de la conversación por voz" aria-label="Modo de voz">
              <option value="director">Voz del Director</option>
              <option value="rapida">Voz rápida (navegador)</option>
            </select>
            <button type="button" id="btnDetenerVoz" class="btn-secondary btn-sm" title="Interrumpir al Director y volver a escuchar" hidden aria-label="Interrumpir al Director">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="6" height="6"></rect>
              </svg>
            </button>
            <button type="button" id="btnAdjuntar" class="btn-secondary btn-sm" title="Opciones de la conversación">⋮</button>
            <button type="submit" id="btnEnviar" class="btn-primary btn-sm" disabled>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
          <div id="alertaForm" class="director-ia-alerta" hidden role="alert" aria-live="assertive"></div>
          <div id="estadoVoz" class="director-ia-estado-voz" hidden role="status" aria-live="polite">
            <span class="punto-voz" aria-hidden="true"></span>
            <span id="textoEstadoVoz">Listo para hablar</span>
          </div>
        </form>
      </section>
    </main>
  </div>

  <script is:inline>
    (function () {
      const API_BASE = '/api/admin/director-ia';

      const els = {
        contenedor: document.getElementById('contenedorMensajes'),
        form: document.getElementById('formMensaje'),
        input: document.getElementById('inputMensaje'),
        btnEnviar: document.getElementById('btnEnviar'),
        btnAdjuntar: document.getElementById('btnAdjuntar'),
        btnVoz: document.getElementById('btnVoz'),
        btnDetenerVoz: document.getElementById('btnDetenerVoz'),
        titulo: document.getElementById('tituloConversacion'),
        subtitulo: document.getElementById('subtituloConversacion'),
        estado: document.getElementById('estadoConexion'),
        textoEstado: document.getElementById('textoEstado'),
        alerta: document.getElementById('alertaForm'),
        btnConfigurarConversacion: document.getElementById('btnConfigurarConversacion'),
        panelConfiguracion: document.getElementById('panelConfiguracion'),
        inputConversacionId: document.getElementById('inputConversacionId'),
        btnGuardarConversacionId: document.getElementById('btnGuardarConversacionId'),
        btnLimpiarConversacionId: document.getElementById('btnLimpiarConversacionId'),
        alertaConversacionId: document.getElementById('alertaConversacionId'),
      };

      let enVuelo = false;
      let conversacionIdConfigurada = null;

      // ── configuración de conversación (compartir con Telegram) ──
      function leerConversacionIdGuardada() {
        try {
          const v = localStorage.getItem('directorIa_conversacionId');
          return v || null;
        } catch { return null; }
      }
      function guardarConversacionId(id) {
        try { localStorage.setItem('directorIa_conversacionId', id || ''); } catch { /* sin localStorage */ }
        conversacionIdConfigurada = id || null;
      }
      function urlConConversacionId(path) {
        if (!conversacionIdConfigurada) return path;
        const sep = path.includes('?') ? '&' : '?';
        return `${path}${sep}conversacionId=${encodeURIComponent(conversacionIdConfigurada)}`;
      }
      function mostrarAlertaConversacionId(texto) {
        if (!els.alertaConversacionId) return;
        els.alertaConversacionId.hidden = !texto;
        if (texto) els.alertaConversacionId.textContent = texto;
      }

      // ── estado de conexión ──
      async function comprobarEstado() {
        try {
          const res = await fetch(`${API_BASE}/status`, { headers: { 'cache-control': 'no-store' } });
          const j = await leerJson(res);
          if (j.success && j.conectado) {
            ponerEstado('conectado', 'Conectado con el Director.');
          } else {
            ponerEstado('desconectado', j.motivo === 'no_configurado'
              ? 'Servicio no configurado en el servidor.'
              : 'No se pudo contactar con el servicio del Director.');
          }
        } catch {
          ponerEstado('desconectado', 'Servicio no disponible.');
        }
      }

      function ponerEstado(tipo, texto) {
        if (!els.estado || !els.textoEstado) return;
        const punto = els.estado.querySelector('.punto');
        els.textoEstado.textContent = texto;
        els.estado.className = 'director-ia-estado director-ia-estado--' + tipo;
        if (punto) punto.className = 'punto punto--' + tipo;
      }

      async function cargarConversacionPrincipal() {
        if (!els.contenedor) return;
        els.contenedor.innerHTML = '<div class="director-ia-cargando">Cargando historial…</div>';
        try {
          const res = await fetch(urlConConversacionId(`${API_BASE}/principal`), { headers: { 'cache-control': 'no-store' } });
          const j = await leerJson(res);
          if (!j.success) throw new Error(j.message || 'No se pudo cargar el historial');
          renderizarMensajes(j.conversacion);
        } catch (e) {
          els.contenedor.innerHTML = '<div class="director-ia-error">No se pudo cargar la conversación principal.</div>';
          console.error(e);
        }
      }

      // ── historial: carga progresiva y desplazamiento que respeta la posición del lector ──
      const POR_BLOQUE = 40;
      let mensajesActuales = []; let mostradosDesde = 0;
      function cercaDelFinal() { const c = els.contenedor; return !c || (c.scrollHeight - c.scrollTop - c.clientHeight) < 140; }
      function botonAnteriores() {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'btn-secondary btn-sm director-ia-cargar-anteriores';
        b.textContent = `Ver ${Math.min(POR_BLOQUE, mostradosDesde)} mensajes anteriores`;
        b.addEventListener('click', () => {
          const c = els.contenedor; const antes = c.scrollHeight; const desde = Math.max(0, mostradosDesde - POR_BLOQUE);
          const nodos = mensajesActuales.slice(desde, mostradosDesde).map(crearNodoMensaje);
          const ref = b.nextSibling || null; if (b.parentNode) b.parentNode.removeChild(b);
          for (const n of nodos) { if (c.insertBefore) c.insertBefore(n, ref); else c.appendChild(n); }
          mostradosDesde = desde;
          if (desde > 0) { const nb = botonAnteriores(); if (c.insertBefore) c.insertBefore(nb, c.firstChild || null); else c.appendChild(nb); }
          c.scrollTop += c.scrollHeight - antes; // conserva lo que estabas leyendo
        });
        return b;
      }

      function renderizarMensajes(conversacion) {
        if (!els.contenedor || !els.titulo || !els.subtitulo) return;
        els.titulo.textContent = (Chats.actual() && Chats.actual().titulo) || conversacion.titulo || 'Director IA';
        els.subtitulo.textContent = conversacion.mensajes && conversacion.mensajes.length
          ? conversacion.mensajes.length + ' mensaje' + (conversacion.mensajes.length === 1 ? '' : 's') + ' · ' + fechaLegera(conversacion.actualizadoEn)
          : 'Sin mensajes aún.';
        els.contenedor.innerHTML = '';
        mensajesActuales = Array.isArray(conversacion.mensajes) ? conversacion.mensajes : [];
        mostradosDesde = Math.max(0, mensajesActuales.length - POR_BLOQUE);
        if (mostradosDesde > 0) els.contenedor.appendChild(botonAnteriores());
        for (const m of mensajesActuales.slice(mostradosDesde)) els.contenedor.appendChild(crearNodoMensaje(m));
        if (!mensajesActuales.length) { const v = document.createElement('div'); v.className = 'director-ia-vacio-centrado'; v.textContent = 'Escribe o habla para empezar esta conversación con el Director.'; els.contenedor.appendChild(v); }
        scrollFinal(true);
      }

      function crearNodoMensaje(m) {
        const div = document.createElement('div');
        div.className = 'director-ia-burbuja director-ia-burbuja--' + m.rol;
        const hora = m.en ? fechaHora(m.en) : '';
        const meta = [];
        if (m.rol === 'director') {
          if (m.estado) meta.push(m.estado);
          if (!m.controles || m.controles.registrada === false) meta.push('no registrada');
          if (m.tipoIntencion) meta.push('intención: ' + m.tipoIntencion);
        }
        const metaHtml = meta.length ? '<span class="director-ia-meta">' + escapeHtml(meta.join(' · ')) + '</span>' : '';
        const cuerpo = document.createElement('div');
        cuerpo.className = 'director-ia-burbuja-cuerpo md';
        cuerpo.innerHTML = renderMarkdown(m.contenido ?? '');
        div.innerHTML =
          '<div class="director-ia-burbuja-cabecera">' +
          (m.rol === 'usuario' ? 'Tú' : 'Director IA') + ' <span class="director-ia-burbuja-hora">' + escapeHtml(hora) + '</span>' +
          metaHtml +
          '</div>';
        div.appendChild(cuerpo);
        if (m.rol === 'director') {
          const extras = document.createElement('div');
          extras.innerHTML = renderizarExtrasDirector(m);
          div.appendChild(extras);
        }
        const acc = document.createElement('div'); acc.className = 'director-ia-burbuja-acciones';
        const bCopiar = document.createElement('button'); bCopiar.type = 'button'; bCopiar.textContent = 'Copiar'; bCopiar.setAttribute('aria-label', 'Copiar el mensaje');
        bCopiar.addEventListener('click', () => copiarTexto(m.contenido ?? '', bCopiar));
        const bReusar = document.createElement('button'); bReusar.type = 'button'; bReusar.textContent = 'Reutilizar'; bReusar.setAttribute('aria-label', 'Llevar el mensaje al campo de escritura');
        bReusar.addEventListener('click', () => { if (els.input) { els.input.value = String(m.contenido ?? '').slice(0, 2000); ajustarAltura(); if (els.btnEnviar) els.btnEnviar.disabled = !els.input.value.trim() || enVuelo; els.input.focus(); } });
        acc.appendChild(bCopiar); acc.appendChild(bReusar); div.appendChild(acc);
        return div;
      }

      async function copiarTexto(texto, boton) {
        let ok = false;
        try { if (window.navigator && navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(String(texto)); ok = true; } } catch { ok = false; }
        if (!ok) { try { const t = document.createElement('textarea'); t.value = String(texto); document.body.appendChild(t); t.select(); ok = document.execCommand('copy'); t.remove(); } catch { ok = false; } }
        if (boton) { const antes = boton.textContent; boton.textContent = ok ? 'Copiado' : 'No se pudo copiar'; setTimeout(() => { boton.textContent = antes; }, 1500); }
      }

      /**
       * Markdown SEGURO: primero se escapa TODO el texto (ningún HTML del mensaje llega al DOM) y después se aplica un subconjunto:
       * párrafos, títulos, negrita, cursiva, código en línea y en bloque, listas, tablas y enlaces http(s) (abren aparte, sin referer).
       */
      function renderMarkdown(texto) {
        const lineas = String(texto ?? '').replace(/\r\n?/g, '\n').split('\n'); const salida = []; let i = 0;
        const enlinea = (t) => escapeHtml(t)
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/(^|[^*\w])\*([^*\s][^*]*)\*/g, '$1<em>$2</em>')
          .replace(/\[([^\]]{1,200})\]\((https?:\/\/[^\s)"'<>]{1,500})\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer nofollow">$1</a>')
          .replace(/(^|[\s(])(https?:\/\/[^\s<)"']{1,500})/g, '$1<a href="$2" target="_blank" rel="noopener noreferrer nofollow">$2</a>');
        const esTabla = (l) => /^\s*\|.*\|\s*$/.test(l);
        const celdas = (l) => l.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim());
        const especial = /^```|^#{1,6}\s|^\s*([-*•]|\d+[.)])\s+/;
        while (i < lineas.length) {
          const l = lineas[i];
          if (/^```/.test(l)) { const cod = []; i += 1; while (i < lineas.length && !/^```/.test(lineas[i])) { cod.push(lineas[i]); i += 1; } i += 1; salida.push('<pre><code>' + escapeHtml(cod.join('\n')) + '</code></pre>'); continue; }
          const h = /^(#{1,6})\s+(.*)$/.exec(l); if (h) { const n = Math.min(6, h[1].length + 2); salida.push('<h' + n + '>' + enlinea(h[2]) + '</h' + n + '>'); i += 1; continue; }
          if (esTabla(l) && i + 1 < lineas.length && /^\s*\|?\s*:?-{2,}/.test(lineas[i + 1])) {
            const cab = celdas(l); i += 2; const filas = []; while (i < lineas.length && esTabla(lineas[i])) { filas.push(celdas(lineas[i])); i += 1; }
            salida.push('<table><thead><tr>' + cab.map((c) => '<th>' + enlinea(c) + '</th>').join('') + '</tr></thead><tbody>' + filas.map((f) => '<tr>' + f.map((c) => '<td>' + enlinea(c) + '</td>').join('') + '</tr>').join('') + '</tbody></table>'); continue;
          }
          if (/^\s*([-*•]|\d+[.)])\s+/.test(l)) {
            const ordenada = /^\s*\d+[.)]/.test(l); const items = [];
            while (i < lineas.length && /^\s*([-*•]|\d+[.)])\s+/.test(lineas[i])) { items.push(lineas[i].replace(/^\s*([-*•]|\d+[.)])\s+/, '')); i += 1; }
            salida.push((ordenada ? '<ol>' : '<ul>') + items.map((x) => '<li>' + enlinea(x) + '</li>').join('') + (ordenada ? '</ol>' : '</ul>')); continue;
          }
          if (!l.trim()) { i += 1; continue; }
          const parr = []; while (i < lineas.length && lineas[i].trim() && !especial.test(lineas[i]) && !esTabla(lineas[i])) { parr.push(enlinea(lineas[i])); i += 1; }
          if (!parr.length) { parr.push(enlinea(l)); i += 1; }
          salida.push('<p>' + parr.join('<br>') + '</p>');
        }
        return salida.join('');
      }

      function renderizarExtrasDirector(m) {
        const partes = [];
        if (m.naturalezaDatos && m.naturalezaDatos.length) {
          partes.push('<div class="director-ia-dato">Naturaleza: ' + m.naturalezaDatos.map((n) => escapeHtml(n.etiqueta)).join(', ') + '</div>');
        }
        if (m.fuentes && m.fuentes.length) {
          partes.push('<div class="director-ia-fuentes">Fuentes: ' + m.fuentes.map((f) => escapeHtml(f.texto) + (f.procedencia ? ' (' + escapeHtml(f.procedencia) + ')' : '')).join('; ') + '</div>');
        }
        if (m.tareas && m.tareas.length) {
          partes.push('<div class="director-ia-tareas">Tareas: ' + m.tareas.map((t) => escapeHtml(t.idTarea) + ' (' + escapeHtml(t.estado) + ')').join(', ') + '</div>');
        }
        if (m.solicitudesAutorizacion && m.solicitudesAutorizacion.length) {
          partes.push('<div class="director-ia-auth">Pendientes de tu aprobación: ' + m.solicitudesAutorizacion.map((s) => escapeHtml(s.idAprobacion) + ' ' + escapeHtml(s.nivel)).join(', ') + '</div>');
        }
        if (m.limitaciones && m.limitaciones.length) {
          partes.push('<div class="director-ia-limites">⚠ ' + m.limitaciones.map(escapeHtml).join('; ') + '</div>');
        }
        if (m.avisos && m.avisos.length) {
          partes.push('<div class="director-ia-avisos">' + m.avisos.map((a) => '⚠ ' + escapeHtml(a)).join('<br>') + '</div>');
        }
        return partes.join('');
      }

      /**
       * Lee la respuesta como JSON solo si el servidor la envía como JSON. Una sesión caducada (texto
       * «Autenticacion requerida»), una página de error del proxy o un HTML se convierten en un error
       * comprensible en lugar de «Unexpected token <».
       */
      async function leerJson(res) {
        const tipo = res.headers.get('content-type') || '';
        if (!tipo.includes('application/json')) {
          if (res.status === 401) throw new Error('La sesión ha caducado. Vuelve a iniciar sesión en el panel.');
          throw new Error(`El servidor no respondió con datos válidos (HTTP ${res.status}).`);
        }
        return res.json();
      }

      async function enviarConCabeceraSegura(url, init) {
        const cabeceras = { 'Content-Type': 'application/json; charset=utf-8', ...(init.headers || {}) };
        if (init.method && (init.method.toUpperCase() === 'POST' || init.method.toUpperCase() === 'PUT' || init.method.toUpperCase() === 'DELETE' || init.method.toUpperCase() === 'PATCH')) {
          cabeceras['X-Director-IA'] = '1';
        }
        return fetch(url, { ...init, headers: cabeceras });
      }

      // ── enviar mensaje ──
      async function enviarMensaje(e) {
        e.preventDefault();
        if (enVuelo) return;
        const texto = els.input.value.trim();
        if (!texto) return;
        enVuelo = true;
        els.btnEnviar.disabled = true;
        els.input.disabled = true;
        mostrarAlerta(null);

        // mensaje de usuario optimista
        const ahora = new Date().toISOString();
