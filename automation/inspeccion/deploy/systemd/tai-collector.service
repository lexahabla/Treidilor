# PLANTILLA (no instalada). Se validaría con `systemd-analyze security` en la etapa 3.
# El colector es el ÚNICO componente privilegiado: debe seguir mínimo, propiedad de root y verificado por manifiesto.
[Unit]
Description=Colector de diagnosticos de solo lectura (Treidilor AI)
Documentation=file:///opt/tai-inspect/LEEME.md

[Service]
Type=oneshot
ExecStart=/opt/tai-inspect/bin/tai-collector
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/tai-inspect /var/log/tai-inspect
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
UMask=0027
MemoryMax=128M
CPUQuota=20%
TasksMax=64
TimeoutStartSec=60
Nice=19
IOSchedulingClass=idle
